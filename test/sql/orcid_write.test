statement ok
CREATE TABLE out_peer_reviews AS
SELECT p.source_hash AS doc_hash,
       orcid_peer_review_to_xml(struct_insert(p, external_ids := (SELECT list(e ORDER BY e.rowid) FROM src_peer_review_ids e WHERE e.source_hash = p.source_hash))) AS xml,
       orcid_peer_review_to_json(struct_insert(p, external_ids := (SELECT list(e ORDER BY e.rowid) FROM src_peer_review_ids e WHERE e.source_hash = p.source_hash))) AS json
FROM src_peer_reviews p;

