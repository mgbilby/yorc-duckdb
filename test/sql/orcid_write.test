# ---------------------------------------------------------------- person items: address, keyword, other name, researcher url (with and without a name), external identifier

statement ok
CREATE TABLE src_person_items AS
SELECT p.* FROM (SELECT doc FROM docs WHERE format = 'xml' AND name IN ('address-3.0.xml', 'keyword-3.0.xml', 'other-name-3.0.xml',
    'researcher-url-3.0.xml', 'researcher-url-3.0-no-name.xml', 'external-identifier-3.0.xml')) d, orcid_person_items_xml(d.doc) p
UNION ALL
SELECT p.* FROM (SELECT doc FROM docs WHERE name IN ('address-3.0.json', 'researcher-url-3.0.json', 'researcher-url-no-name-3.0.json',
    'external-identifier-3.0.json')) d, orcid_person_items_json(d.doc) p
UNION ALL
SELECT p.* FROM (SELECT doc FROM docs WHERE name = 'keywords-3.0.json') d, orcid_person_items_json(d.doc, json_root := 'keyword') p
UNION ALL
SELECT p.* FROM (SELECT doc FROM docs WHERE name = 'other-names-3.0.json') d, orcid_person_items_json(d.doc, json_root := 'other-name') p;

query II
SELECT count(*), string_agg(DISTINCT kind, ',' ORDER BY kind) FROM src_person_items;
----
12	address,external-identifier,keyword,other-name,researcher-url

statement ok
CREATE TABLE out_person_items AS
SELECT kind, orcid_person_item_to_xml(p) AS xml, orcid_person_item_to_json(p) AS json FROM src_person_items p;

query I
SELECT count(*) FROM (
  (SELECT * EXCLUDE (source_hash) FROM src_person_items
   EXCEPT ALL SELECT p.* EXCLUDE (source_hash) FROM out_person_items o, orcid_person_items_xml(o.xml) p)
  UNION ALL
  (SELECT p.* EXCLUDE (source_hash) FROM out_person_items o, orcid_person_items_xml(o.xml) p
   EXCEPT ALL SELECT * EXCLUDE (source_hash) FROM src_person_items));
