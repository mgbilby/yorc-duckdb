# peer-review-3.0.xsd: review-identifiers hold common:external-id directly; the dates are review-completion-date
query III
SELECT contains(xml, '<peer-review:review-identifiers>' || chr(10) || chr(9) || chr(9) || '<common:external-id>'),
       contains(xml, '<peer-review:review-completion-date>'),
       contains(json, '"review-identifiers": {')
FROM out_peer_reviews WHERE doc_hash = (SELECT sha256(doc) FROM docs WHERE name = 'peer-review-full-3.0.xml');
