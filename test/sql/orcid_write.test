# ---------------------------------------------------------------- output format, read-only fields, derived fields

query I
SELECT replace(replace(orcid_work_to_xml({'title': 'T', 'type': 'other'}), chr(10), '\n'), chr(9), '\t');
----
<?xml version="1.0" encoding="UTF-8"?>\n<work:work xmlns:common="http://www.orcid.org/ns/common" xmlns:work="http://www.orcid.org/ns/work">\n\t<work:title>\n\t\t<common:title>T</common:title>\n\t</work:title>\n\t<work:type>other</work:type>\n</work:work>\n

query I
SELECT replace(orcid_work_to_json({'title': 'T', 'type': 'other'}), chr(10), '\n');
----
{\n  "title": {\n    "title": {\n      "value": "T"\n    }\n  },\n  "type": "other"\n}\n

# put-code (an update needs it) and visibility are written: an attribute in XML, a member in JSON (a number for
# put-code); source, dates, path and display index are read-only and are not
query IIIII
SELECT contains(x, '<work:work xmlns:common="http://www.orcid.org/ns/common" xmlns:work="http://www.orcid.org/ns/work" put-code="7" visibility="public">'),
       contains(j, '"put-code": 7,') AND contains(j, '"visibility": "public"'),
       NOT contains(x, 'source') AND NOT contains(x, 'created') AND NOT contains(x, 'display-index') AND NOT contains(x, 'path='),
       contains(x, '<common:month>02</common:month>') AND contains(x, '<common:day>09</common:day>'),
       contains(j, '"day": {' || chr(10) || '      "value": "09"')
FROM (SELECT orcid_work_to_xml(r) AS x, orcid_work_to_json(r) AS j
      FROM (SELECT {'put_code': 7, 'visibility': 'public', 'title': 'T', 'type': 'other', 'pub_year': 2001, 'pub_month': 2,
                    'pub_day': 9, 'source_name': 'S', 'created': '2020-01-01T00:00:00.000Z', 'path': '/p', 'display_index': 3} AS r));
----
true	true	true	true	true

# a contributor's contributor-orcid host is written after uri and path (common:orcid-id;
# write_samples/work-full-3.0.xml lines 46-50 carry it), and needs the path
query II
SELECT contains(x, '<common:path>0000-0002-1825-0097</common:path>' || chr(10) || chr(9) || chr(9) || chr(9) || chr(9) || '<common:host>orcid.org</common:host>'),
       (SELECT contributor_orcid_host FROM orcid_contributors_xml(x))
FROM (SELECT orcid_work_to_xml({'title': 'T', 'type': 'other',
          'contributors': [{'contributor_orcid': '0000-0002-1825-0097', 'contributor_orcid_host': 'orcid.org'}]}) AS x);
----
true	orcid.org

statement error
SELECT orcid_work_to_xml({'title': 'T', 'type': 'other', 'contributors': [{'contributor_orcid_host': 'orcid.org', 'credit_name': 'A'}]});
----
'contributors[1].contributor_orcid_host' needs 'contributors[1].contributor_orcid'

# a work's doi without external_ids becomes its self DOI identifier; given external_ids win
query III
SELECT (SELECT doi FROM orcid_works_xml(orcid_work_to_xml({'title': 'T', 'type': 'other', 'doi': '10.1/X'}))),
       (SELECT type || ' ' || value || ' ' || relationship FROM orcid_external_ids_xml(orcid_work_to_xml({'title': 'T', 'type': 'other', 'doi': '10.1/X'}))),
       (SELECT count(*) FROM orcid_external_ids_xml(orcid_work_to_xml({'title': 'T', 'type': 'other', 'doi': '10.1/X',
                                                                     'external_ids': [{'type': 'isbn', 'value': '1', 'relationship': 'self'}]})));
----
10.1/x	doi 10.1/X self	1

query I
SELECT orcid_work_to_xml(NULL) IS NULL;
----
true

# ---------------------------------------------------------------- escaping

# XML: & < > in text; " and < in attributes; CR as &#13;; non-BMP characters as UTF-8
query IIII
SELECT contains(x, '<common:title>a &lt; b &amp; "c" ''d'' &gt; e &#13; ' || chr(128512) || '</common:title>'),
       contains(x, 'visibility="pub&quot;lic&lt;"'),
       (SELECT title FROM orcid_works_xml(x)) = 'a < b & "c" ''d'' > e ' || chr(13) || ' ' || chr(128512),
       (SELECT visibility FROM orcid_works_xml(x)) = 'pub"lic<'
FROM (SELECT orcid_work_to_xml({'title': 'a < b & "c" ''d'' > e ' || chr(13) || ' ' || chr(128512), 'type': 'other', 'visibility': 'pub"lic<'}) AS x);
----
true	true	true	true

# JSON: " \ and control characters escaped (\n \t \uXXXX), U+2028 as  , non-BMP characters as UTF-8
query II
SELECT contains(j, '"value": "\"q\" \\ x\n\t\u0001   ' || chr(128512) || '"'),
       (SELECT title FROM orcid_works_json(j)) = '"q" \ x' || chr(10) || chr(9) || chr(1) || ' ' || chr(8232) || ' ' || chr(128512)
FROM (SELECT orcid_work_to_json({'title': '"q" \ x' || chr(10) || chr(9) || chr(1) || ' ' || chr(8232) || ' ' || chr(128512), 'type': 'other'}) AS j);
----
true	true

# XML 1.0 cannot carry U+0001 at all, so it is an error rather than a document
statement error
SELECT orcid_work_to_xml({'title': 'bell' || chr(1), 'type': 'other'});
----
cannot be written in XML 1.0

# (invalid UTF-8 cannot reach a VARCHAR in DuckDB; the core refuses it: test/cpp/core_test.cpp, TestWriterOutput)

# ---------------------------------------------------------------- input checks

statement error
SELECT orcid_work_to_xml({'titel': 'T', 'type': 'other'});
----
unknown field 'titel'

statement error
SELECT orcid_work_to_xml({'title': 'T', 'type': 'other', 'external_ids': [{'typ': 'doi', 'value': 'x'}]});
----
unknown field 'external_ids[].typ'

statement error
SELECT orcid_work_to_xml({'title': 'T', 'type': 'other', 'external_ids': 'x'});
----
must be a LIST of STRUCT

statement error
SELECT orcid_work_to_xml('T');
----
must be a STRUCT

statement error
SELECT orcid_work_to_json({'type': 'other'});
----
'title' is required

statement error
SELECT orcid_work_to_xml({'title': 'T', 'type': 'other', 'translated_title': 'U'});
----
'translated_title_language' is required with 'translated_title'

statement error
SELECT orcid_work_to_xml({'title': 'T', 'type': 'other', 'pub_year': 1850});
----
outside the schema's range 1900..2100

statement error
SELECT orcid_funding_to_xml({'type': 'grant', 'title': 'T'});
----
'org_name' is required

# funding-3.0.xsd's contributor-attributes have no contributor-sequence: a
# funding contributor's sequence is an error (as yorc-rs's Error::Unwritable),
# not a value silently dropped
statement error
SELECT orcid_funding_to_xml({'type': 'grant', 'org_name': 'O',
                             'contributors': [{'credit_name': 'A', 'role': 'lead'}, {'credit_name': 'B', 'sequence': 'first'}]});
----
funding/contributors/contributor[2]/contributor-attributes/contributor-sequence

statement error
SELECT orcid_funding_to_json({'type': 'grant', 'org_name': 'O', 'contributors': [{'credit_name': 'B', 'sequence': 'additional'}]});
----
'contributors[1].sequence' (funding/contributors/contributor[1]/contributor-attributes/contributor-sequence): a funding contributor has no contributor-sequence (funding-3.0.xsd)

# a NULL or blank sequence is absent, as every field: written without it
query I
SELECT contains(orcid_funding_to_xml({'type': 'grant', 'org_name': 'O',
                                      'contributors': [{'credit_name': 'B', 'sequence': NULL, 'role': 'lead'},
                                                       {'credit_name': 'C', 'sequence': ' ', 'role': 'lead'}]}),
                '<funding:contributor-role>lead</funding:contributor-role>');
----
true

statement error
SELECT orcid_affiliation_to_xml({'org_name': 'O'});
----
'affiliation_type' is required

statement error
SELECT orcid_person_item_to_xml({'kind': 'email', 'value': 'a@b.c'});
----
kind must be one of

statement error
SELECT orcid_research_resource_to_xml({'title': 'T', 'host_name': 'H'});
----
'resource_items' needs at least one item

statement error
SELECT orcid_peer_review_to_xml({'reviewer_role': 'reviewer', 'review_type': 'review', 'review_group_id': 'issn:1234-5678',
                                 'completion_year': 2020, 'convening_org_name': 'O',
                                 'external_ids': [{'container': 'peer-review', 'type': 'doi', 'value': '1'},
                                                  {'container': 'peer-review', 'type': 'doi', 'value': '2'}]});
----
more than one external_ids item has container 'peer-review'
