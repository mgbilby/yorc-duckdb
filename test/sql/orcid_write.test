  (SELECT * EXCLUDE (source_hash) FROM src_group_ids
   EXCEPT ALL SELECT g.* EXCLUDE (source_hash) FROM src_group_ids s, orcid_group_ids_xml(orcid_group_id_to_xml(s)) g)
  UNION ALL
  (SELECT g.* EXCLUDE (source_hash) FROM src_group_ids s, orcid_group_ids_xml(orcid_group_id_to_xml(s)) g
   EXCEPT ALL SELECT * EXCLUDE (source_hash) FROM src_group_ids)
  UNION ALL
  (SELECT * EXCLUDE (source_hash) FROM src_group_ids
   EXCEPT ALL SELECT g.* EXCLUDE (source_hash) FROM src_group_ids s, orcid_group_ids_json(orcid_group_id_to_json(s)) g)
  UNION ALL
  (SELECT g.* EXCLUDE (source_hash) FROM src_group_ids s, orcid_group_ids_json(orcid_group_id_to_json(s)) g
