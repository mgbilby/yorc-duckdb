# funding-3.0.xml: <funding:amount currency-code="ADP">1000</funding:amount>; the organization comes last (funding-3.0.xsd)
query III
SELECT contains(xml, '<funding:amount currency-code="ADP">1000</funding:amount>'),
       position('<common:organization>' IN xml) > position('<common:external-ids>' IN xml),
       contains(json, '"amount": {' || chr(10) || '    "value": "1000",' || chr(10) || '    "currency-code": "ADP"' || chr(10) || '  }')
FROM out_fundings WHERE doc_hash = (SELECT sha256(doc) FROM docs WHERE name = 'funding-3.0.xml');
----
true	true	true

