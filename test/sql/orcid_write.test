  (SELECT count(*) AS n FROM (SELECT a.* EXCLUDE (source_hash) FROM out_affiliations o, orcid_affiliations_xml(o.xml) a
   EXCEPT ALL SELECT * EXCLUDE (source_hash) FROM src_affiliations))
  UNION ALL
  (SELECT count(*) AS n FROM (SELECT * EXCLUDE (source_hash) FROM src_affiliation_ids
   EXCEPT ALL SELECT e.* EXCLUDE (source_hash) FROM out_affiliations o, orcid_external_ids_xml(o.xml) e))
  UNION ALL
  (SELECT count(*) AS n FROM (SELECT e.* EXCLUDE (source_hash) FROM out_affiliations o, orcid_external_ids_xml(o.xml) e
   EXCEPT ALL SELECT * EXCLUDE (source_hash) FROM src_affiliation_ids)));
----
0

