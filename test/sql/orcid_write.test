{\n  "name": "Group ID name",\n  "group-id": "ringgold:355321",\n  "description": "Description for a peer-review group id.",\n  "type": "magazine"\n}\n

# ---------------------------------------------------------------- bulk works: bulk-work-3.0 (xml, json), bulk-works-3-works, bulk-works-100-works
# One external id per work in all four (python3 -I; grep -c on the XML), so
# the k-th id of a document belongs to its k-th work. Contributors: only the
# second work of bulk-works-3-works-3.0.json has any (one); bulk-works-100's
# are not reassembled (they cannot be told apart by work), so its contributors
# are not compared.

statement ok
CREATE TABLE src_bulk_works AS
SELECT w.* FROM (SELECT doc FROM docs WHERE name LIKE 'bulk-%' AND format = 'xml') d, orcid_works_xml(d.doc) w
UNION ALL
SELECT w.* FROM (SELECT doc FROM docs WHERE name LIKE 'bulk-%' AND format = 'json') d, orcid_works_json(d.doc) w;

statement ok
CREATE TABLE src_bulk_ids AS
SELECT e.* FROM (SELECT doc FROM docs WHERE name LIKE 'bulk-%' AND format = 'xml') d, orcid_external_ids_xml(d.doc) e
UNION ALL
SELECT e.* FROM (SELECT doc FROM docs WHERE name LIKE 'bulk-%' AND format = 'json') d, orcid_external_ids_json(d.doc) e;

statement ok
CREATE TABLE src_bulk_contributors AS
SELECT c.* FROM (SELECT doc FROM docs WHERE name = 'bulk-works-3-works-3.0.json') d, orcid_contributors_json(d.doc) c;

query III
SELECT (SELECT count(*) FROM src_bulk_works), (SELECT count(*) FROM src_bulk_ids), (SELECT count(*) FROM src_bulk_contributors);
----
107	107	1

statement ok
CREATE TABLE rec_bulk AS
SELECT w.source_hash AS doc_hash, wn.n,
       struct_insert(w,
           external_ids := (SELECT list(e) FROM src_bulk_ids e
                            JOIN (SELECT rowid AS rid, row_number() OVER (PARTITION BY source_hash ORDER BY rowid) AS n FROM src_bulk_ids) en
                              ON en.rid = e.rowid
                            WHERE e.source_hash = w.source_hash AND en.n = wn.n),
           contributors := (SELECT list(c ORDER BY c.ordinal) FROM src_bulk_contributors c
                            WHERE c.source_hash = w.source_hash AND wn.n = 2)) AS rec
FROM src_bulk_works w
JOIN (SELECT rowid AS rid, row_number() OVER (PARTITION BY source_hash ORDER BY rowid) AS n FROM src_bulk_works) wn ON wn.rid = w.rowid;

statement ok
CREATE TABLE out_bulk AS
SELECT doc_hash, orcid_bulk_works_to_xml(list(rec ORDER BY n)) AS xml, orcid_bulk_works_to_json(list(rec ORDER BY n)) AS json
FROM rec_bulk GROUP BY doc_hash;

query I
SELECT sum(n)::BIGINT FROM (
  (SELECT count(*) AS n FROM (SELECT * EXCLUDE (source_hash) FROM src_bulk_works EXCEPT ALL SELECT w.* EXCLUDE (source_hash) FROM out_bulk o, orcid_works_xml(o.xml) w))
  UNION ALL
  (SELECT count(*) AS n FROM (SELECT w.* EXCLUDE (source_hash) FROM out_bulk o, orcid_works_xml(o.xml) w EXCEPT ALL SELECT * EXCLUDE (source_hash) FROM src_bulk_works))
  UNION ALL
  (SELECT count(*) AS n FROM (SELECT * EXCLUDE (source_hash) FROM src_bulk_works EXCEPT ALL SELECT w.* EXCLUDE (source_hash) FROM out_bulk o, orcid_works_json(o.json) w))
  UNION ALL
  (SELECT count(*) AS n FROM (SELECT w.* EXCLUDE (source_hash) FROM out_bulk o, orcid_works_json(o.json) w EXCEPT ALL SELECT * EXCLUDE (source_hash) FROM src_bulk_works))
  UNION ALL
  (SELECT count(*) AS n FROM (SELECT * EXCLUDE (source_hash) FROM src_bulk_ids EXCEPT ALL SELECT e.* EXCLUDE (source_hash) FROM out_bulk o, orcid_external_ids_xml(o.xml) e))
  UNION ALL
  (SELECT count(*) AS n FROM (SELECT e.* EXCLUDE (source_hash) FROM out_bulk o, orcid_external_ids_xml(o.xml) e EXCEPT ALL SELECT * EXCLUDE (source_hash) FROM src_bulk_ids))
  UNION ALL
  (SELECT count(*) AS n FROM (SELECT * EXCLUDE (source_hash) FROM src_bulk_ids EXCEPT ALL SELECT e.* EXCLUDE (source_hash) FROM out_bulk o, orcid_external_ids_json(o.json) e))
  UNION ALL
  (SELECT count(*) AS n FROM (SELECT e.* EXCLUDE (source_hash) FROM out_bulk o, orcid_external_ids_json(o.json) e EXCEPT ALL SELECT * EXCLUDE (source_hash) FROM src_bulk_ids)));
----
0

query I
SELECT count(*) FROM (
  (SELECT * EXCLUDE (source_hash) FROM src_bulk_contributors
   EXCEPT ALL SELECT c.* EXCLUDE (source_hash) FROM out_bulk o, orcid_contributors_json(o.json) c
              WHERE o.doc_hash = (SELECT sha256(doc) FROM docs WHERE name = 'bulk-works-3-works-3.0.json'))
  UNION ALL
  (SELECT c.* EXCLUDE (source_hash) FROM out_bulk o, orcid_contributors_json(o.json) c
   WHERE o.doc_hash = (SELECT sha256(doc) FROM docs WHERE name = 'bulk-works-3-works-3.0.json')
   EXCEPT ALL SELECT * EXCLUDE (source_hash) FROM src_bulk_contributors));
----
0

# bulk-3.0.xsd: <bulk:bulk> holding work:work elements; JSON {"bulk": [{"work": ...}]}
query II
SELECT starts_with(xml, '<?xml version="1.0" encoding="UTF-8"?>' || chr(10) || '<bulk:bulk xmlns:bulk="http://www.orcid.org/ns/bulk" xmlns:common="http://www.orcid.org/ns/common" xmlns:work="http://www.orcid.org/ns/work">'),
       starts_with(json, '{' || chr(10) || '  "bulk": [' || chr(10) || '    {' || chr(10) || '      "work": {')
FROM out_bulk WHERE doc_hash = (SELECT sha256(doc) FROM docs WHERE name = 'bulk-work-3.0.xml');
