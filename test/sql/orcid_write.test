# name: test/sql/orcid_write.test
# description: the writers (orcid_<writer>_to_xml / _to_json, orcid_bulk_works_to_*): every write sample of reference/orcid-model reads, writes and reads back to the same rows, in XML, in JSON and across the two; required fields, the bulk limit, escaping
# group: [orcid]
#
# Method: each write sample is read with the section readers; its rows are
# assembled into the writer's input (the item row as a STRUCT, plus LIST(STRUCT)
# fields of its external ids, contributors, resource items); that is written
# and read back, and the rows must be equal (EXCEPT ALL both ways), source_hash
# aside: it is the SHA-256 of each document read, so it differs by design and
# is what ties the rows of one document together below (source_hash =
# sha256(document)). Expected values that are not rows of the samples come
# from the writer rules in src/core/writer.cpp and from the XSDs.

require yorc

statement ok
CREATE TABLE docs AS
SELECT name, format, xml AS doc FROM orcid_documents('reference/orcid-model/record_3.0/samples/write_samples/*');

# 48 files (ls | wc -l): 21 XML, 27 JSON
query III
SELECT count(*), count(*) FILTER (WHERE format = 'xml'), count(*) FILTER (WHERE format = 'json') FROM docs;
----
48	21	27

# ---------------------------------------------------------------- works: work-full (xml, json), work-simple (xml), the two 51-contributor JSON

statement ok
CREATE TABLE src_works AS
SELECT w.* FROM (SELECT doc FROM docs WHERE name LIKE 'work-%' AND format = 'xml') d, orcid_works_xml(d.doc) w
UNION ALL
SELECT w.* FROM (SELECT doc FROM docs WHERE name LIKE 'work-%' AND format = 'json') d, orcid_works_json(d.doc) w;

statement ok
CREATE TABLE src_work_ids AS
SELECT e.* FROM (SELECT doc FROM docs WHERE name LIKE 'work-%' AND format = 'xml') d, orcid_external_ids_xml(d.doc) e
UNION ALL
SELECT e.* FROM (SELECT doc FROM docs WHERE name LIKE 'work-%' AND format = 'json') d, orcid_external_ids_json(d.doc) e;

statement ok
CREATE TABLE src_work_contributors AS
SELECT c.* FROM (SELECT doc FROM docs WHERE name LIKE 'work-%' AND format = 'xml') d, orcid_contributors_xml(d.doc) c
UNION ALL
SELECT c.* FROM (SELECT doc FROM docs WHERE name LIKE 'work-%' AND format = 'json') d, orcid_contributors_json(d.doc) c;

# 5 works; contributors 1 + 2 + 0 + 51 + 51 (work-simple-3.0.xml has none)
query III
SELECT (SELECT count(*) FROM src_works), (SELECT count(*) FROM src_work_contributors), (SELECT count(*) FROM src_work_ids) > 0;
----
5	105	true

statement ok
CREATE TABLE rec_works AS
SELECT w.source_hash AS doc_hash,
       struct_insert(w,
           external_ids := (SELECT list(e ORDER BY e.rowid) FROM src_work_ids e WHERE e.source_hash = w.source_hash),
           contributors := (SELECT list(c ORDER BY c.ordinal) FROM src_work_contributors c WHERE c.source_hash = w.source_hash)) AS rec
FROM src_works w;

statement ok
CREATE TABLE out_works AS SELECT doc_hash, orcid_work_to_xml(rec) AS xml, orcid_work_to_json(rec) AS json FROM rec_works;

# read -> write XML -> read
query I
SELECT count(*) FROM (
  (SELECT * EXCLUDE (source_hash) FROM src_works
   EXCEPT ALL SELECT w.* EXCLUDE (source_hash) FROM out_works o, orcid_works_xml(o.xml) w)
  UNION ALL
  (SELECT w.* EXCLUDE (source_hash) FROM out_works o, orcid_works_xml(o.xml) w
   EXCEPT ALL SELECT * EXCLUDE (source_hash) FROM src_works));
----
0

query I
SELECT count(*) FROM (
  (SELECT * EXCLUDE (source_hash) FROM src_work_ids
   EXCEPT ALL SELECT e.* EXCLUDE (source_hash) FROM out_works o, orcid_external_ids_xml(o.xml) e)
  UNION ALL
  (SELECT e.* EXCLUDE (source_hash) FROM out_works o, orcid_external_ids_xml(o.xml) e
   EXCEPT ALL SELECT * EXCLUDE (source_hash) FROM src_work_ids));
----
0

query I
SELECT count(*) FROM (
  (SELECT * EXCLUDE (source_hash) FROM src_work_contributors
   EXCEPT ALL SELECT c.* EXCLUDE (source_hash) FROM out_works o, orcid_contributors_xml(o.xml) c)
  UNION ALL
  (SELECT c.* EXCLUDE (source_hash) FROM out_works o, orcid_contributors_xml(o.xml) c
   EXCEPT ALL SELECT * EXCLUDE (source_hash) FROM src_work_contributors));
----
0

# read -> write JSON -> read
query I
SELECT count(*) FROM (
  (SELECT * EXCLUDE (source_hash) FROM src_works
   EXCEPT ALL SELECT w.* EXCLUDE (source_hash) FROM out_works o, orcid_works_json(o.json) w)
  UNION ALL
  (SELECT w.* EXCLUDE (source_hash) FROM out_works o, orcid_works_json(o.json) w
   EXCEPT ALL SELECT * EXCLUDE (source_hash) FROM src_works));
----
0

query I
SELECT count(*) FROM (
  (SELECT * EXCLUDE (source_hash) FROM src_work_ids
   EXCEPT ALL SELECT e.* EXCLUDE (source_hash) FROM out_works o, orcid_external_ids_json(o.json) e)
  UNION ALL
  (SELECT e.* EXCLUDE (source_hash) FROM out_works o, orcid_external_ids_json(o.json) e
   EXCEPT ALL SELECT * EXCLUDE (source_hash) FROM src_work_ids));
----
0

query I
SELECT count(*) FROM (
  (SELECT * EXCLUDE (source_hash) FROM src_work_contributors
   EXCEPT ALL SELECT c.* EXCLUDE (source_hash) FROM out_works o, orcid_contributors_json(o.json) c)
  UNION ALL
  (SELECT c.* EXCLUDE (source_hash) FROM out_works o, orcid_contributors_json(o.json) c
   EXCEPT ALL SELECT * EXCLUDE (source_hash) FROM src_work_contributors));
----
0

# XML -> JSON -> XML: rows read from the JSON output, assembled again, written as XML
statement ok
CREATE TABLE j_works AS SELECT w.* FROM out_works o, orcid_works_json(o.json) w;

statement ok
CREATE TABLE j_work_ids AS SELECT e.* FROM out_works o, orcid_external_ids_json(o.json) e;

statement ok
CREATE TABLE j_work_contributors AS SELECT c.* FROM out_works o, orcid_contributors_json(o.json) c;

statement ok
CREATE TABLE rec_j_works AS
SELECT struct_insert(w,
           external_ids := (SELECT list(e ORDER BY e.rowid) FROM j_work_ids e WHERE e.source_hash = w.source_hash),
           contributors := (SELECT list(c ORDER BY c.ordinal) FROM j_work_contributors c WHERE c.source_hash = w.source_hash)) AS rec
FROM j_works w;

query I
SELECT count(*) FROM (
  (SELECT * EXCLUDE (source_hash) FROM src_works
   EXCEPT ALL SELECT w.* EXCLUDE (source_hash) FROM rec_j_works r, orcid_works_xml(orcid_work_to_xml(r.rec)) w)
  UNION ALL
  (SELECT w.* EXCLUDE (source_hash) FROM rec_j_works r, orcid_works_xml(orcid_work_to_xml(r.rec)) w
   EXCEPT ALL SELECT * EXCLUDE (source_hash) FROM src_works));
----
0

query I
SELECT count(*) FROM (
  (SELECT * EXCLUDE (source_hash) FROM src_work_contributors
   EXCEPT ALL SELECT c.* EXCLUDE (source_hash) FROM rec_j_works r, orcid_contributors_xml(orcid_work_to_xml(r.rec)) c)
  UNION ALL
  (SELECT c.* EXCLUDE (source_hash) FROM rec_j_works r, orcid_contributors_xml(orcid_work_to_xml(r.rec)) c
   EXCEPT ALL SELECT * EXCLUDE (source_hash) FROM src_work_contributors));
----
0

# the written XML follows work-3.0.xsd: namespaces, sequence order, no read-only fields
query IIIII
SELECT starts_with(xml, '<?xml version="1.0" encoding="UTF-8"?>' || chr(10) || '<work:work xmlns:common="http://www.orcid.org/ns/common" xmlns:work="http://www.orcid.org/ns/work">'),
       position('<work:title>' IN xml) < position('<work:journal-title>' IN xml)
         AND position('<work:journal-title>' IN xml) < position('<work:short-description>' IN xml)
         AND position('<work:citation>' IN xml) < position('<work:type>' IN xml)
         AND position('<work:type>' IN xml) < position('<common:publication-date>' IN xml)
         AND position('<common:publication-date>' IN xml) < position('<common:external-ids>' IN xml)
         AND position('<common:external-ids>' IN xml) < position('<common:url>' IN xml)
         AND position('<common:url>' IN xml) < position('<work:contributors>' IN xml)
         AND position('<work:contributors>' IN xml) < position('<common:language-code>' IN xml)
         AND position('<common:language-code>' IN xml) < position('<common:country>' IN xml),
       contains(xml, '<common:translated-title language-code="en">Translated-title English</common:translated-title>'),
       contains(xml, '<common:month>05</common:month>'),
       contains(xml, 'source') OR contains(xml, 'created-date') OR contains(xml, 'put-code')
FROM out_works WHERE doc_hash = (SELECT sha256(doc) FROM docs WHERE name = 'work-full-3.0.json');
----
true	true	true	true	false

# ... and the JSON ORCID's own serialization: value wrappers, arrays of external ids and contributors
query IIII
SELECT contains(json, '"journal-title": {' || chr(10) || '    "value": "Journal title"' || chr(10) || '  }'),
       contains(json, '"external-ids": {' || chr(10) || '    "external-id": ['),
       contains(json, '"contributor": ['),
       contains(json, '"short-description": "This is a short description of the work."')
FROM out_works WHERE doc_hash = (SELECT sha256(doc) FROM docs WHERE name = 'work-full-3.0.json');
----
true	true	true	true

