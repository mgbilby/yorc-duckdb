  (SELECT p.* EXCLUDE (source_hash) FROM out_peer_reviews o, orcid_peer_reviews_xml(o.xml) p
   EXCEPT ALL SELECT * EXCLUDE (source_hash) FROM src_peer_reviews)
  UNION ALL
  (SELECT * EXCLUDE (source_hash) FROM src_peer_reviews
   EXCEPT ALL SELECT p.* EXCLUDE (source_hash) FROM out_peer_reviews o, orcid_peer_reviews_json(o.json) p)
  UNION ALL
  (SELECT p.* EXCLUDE (source_hash) FROM out_peer_reviews o, orcid_peer_reviews_json(o.json) p
   EXCEPT ALL SELECT * EXCLUDE (source_hash) FROM src_peer_reviews));
