  UNION ALL
  ((SELECT p.* EXCLUDE (source_hash) FROM (SELECT json FROM out_person_items WHERE kind NOT IN ('keyword', 'other-name')) o, orcid_person_items_json(o.json) p
    UNION ALL
    SELECT p.* EXCLUDE (source_hash) FROM (SELECT json FROM out_person_items WHERE kind = 'keyword') o, orcid_person_items_json(o.json, json_root := 'keyword') p
    UNION ALL
    SELECT p.* EXCLUDE (source_hash) FROM (SELECT json FROM out_person_items WHERE kind = 'other-name') o, orcid_person_items_json(o.json, json_root := 'other-name') p)
   EXCEPT ALL SELECT * EXCLUDE (source_hash) FROM src_person_items));
