# ---------------------------------------------------------------- the seven affiliation types (XML and JSON samples)

statement ok
CREATE TABLE src_affiliations AS SELECT * FROM orcid_affiliations_xml(NULL);

statement ok
CREATE TABLE src_affiliation_ids AS SELECT * FROM orcid_external_ids_xml(NULL);

foreach type distinction education employment invited-position membership qualification service

statement ok
INSERT INTO src_affiliations
SELECT a.* FROM (SELECT doc FROM docs WHERE name = '${type}-3.0.xml') d, orcid_affiliations_xml(d.doc) a
UNION ALL
SELECT a.* FROM (SELECT doc FROM docs WHERE name = '${type}-3.0.json') d, orcid_affiliations_json(d.doc, json_root := '${type}') a;

statement ok
INSERT INTO src_affiliation_ids
SELECT e.* FROM (SELECT doc FROM docs WHERE name = '${type}-3.0.xml') d, orcid_external_ids_xml(d.doc) e
UNION ALL
SELECT e.* FROM (SELECT doc FROM docs WHERE name = '${type}-3.0.json') d, orcid_external_ids_json(d.doc, json_root := '${type}') e;

endloop

query II
SELECT count(*), count(DISTINCT affiliation_type) FROM src_affiliations;
----
14	7

statement ok
CREATE TABLE rec_affiliations AS
SELECT a.affiliation_type, a.source_hash AS doc_hash,
       struct_insert(a, external_ids := (SELECT list(e ORDER BY e.rowid) FROM src_affiliation_ids e WHERE e.source_hash = a.source_hash)) AS rec
FROM src_affiliations a;

statement ok
CREATE TABLE out_affiliations AS
SELECT affiliation_type, doc_hash, orcid_affiliation_to_xml(rec) AS xml, orcid_affiliation_to_json(rec) AS json FROM rec_affiliations;

query I
SELECT sum(n)::BIGINT FROM (
  (SELECT count(*) AS n FROM (SELECT * EXCLUDE (source_hash) FROM src_affiliations
   EXCEPT ALL SELECT a.* EXCLUDE (source_hash) FROM out_affiliations o, orcid_affiliations_xml(o.xml) a))
