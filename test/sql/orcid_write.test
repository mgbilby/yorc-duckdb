# ---------------------------------------------------------------- research resource (XML and JSON)
# The readers cannot tell a proposal's external ids from an item's (same owner,
# same container), so they are assigned by document order, with the counts of
# each sample (grep -c '<common:external-id>' per element in the XML; python3 -I
# len(external-ids.external-id) in the JSON): XML proposal 2, items 2 + 1;
# JSON proposal 3, items 3 + 1 + 1 + 2 + 2. The JSON proposal has two hosts;
# the readers (and so the writer) keep the first.

statement ok
CREATE TABLE src_rr AS
SELECT r.* FROM (SELECT doc FROM docs WHERE name LIKE 'research-resource-%' AND format = 'xml') d, orcid_research_resources_xml(d.doc) r
UNION ALL
SELECT r.* FROM (SELECT doc FROM docs WHERE name LIKE 'research-resource-%' AND format = 'json') d, orcid_research_resources_json(d.doc) r;

statement ok
CREATE TABLE src_rr_items AS
SELECT i.* FROM (SELECT doc FROM docs WHERE name LIKE 'research-resource-%' AND format = 'xml') d, orcid_research_resource_items_xml(d.doc) i
UNION ALL
SELECT i.* FROM (SELECT doc FROM docs WHERE name LIKE 'research-resource-%' AND format = 'json') d, orcid_research_resource_items_json(d.doc) i;

statement ok
CREATE TABLE src_rr_ids AS
SELECT e.* FROM (SELECT doc FROM docs WHERE name LIKE 'research-resource-%' AND format = 'xml') d, orcid_external_ids_xml(d.doc) e
UNION ALL
SELECT e.* FROM (SELECT doc FROM docs WHERE name LIKE 'research-resource-%' AND format = 'json') d, orcid_external_ids_json(d.doc) e;

statement ok
CREATE TABLE rr_split (format VARCHAR, first_n INTEGER, last_n INTEGER, item INTEGER);

statement ok
INSERT INTO rr_split VALUES ('xml', 1, 2, 0), ('xml', 3, 4, 1), ('xml', 5, 5, 2),
    ('json', 1, 3, 0), ('json', 4, 6, 1), ('json', 7, 7, 2), ('json', 8, 8, 3), ('json', 9, 10, 4), ('json', 11, 12, 5);

statement ok
CREATE TABLE rr_id_item AS
SELECT n.rid, s.item
FROM (SELECT rowid AS rid, source_hash, row_number() OVER (PARTITION BY source_hash ORDER BY rowid) AS n FROM src_rr_ids) n
JOIN docs d ON sha256(d.doc) = n.source_hash
JOIN rr_split s ON s.format = d.format AND n.n BETWEEN s.first_n AND s.last_n;

query III
SELECT (SELECT count(*) FROM src_rr), (SELECT count(*) FROM src_rr_items), (SELECT count(*) FROM rr_id_item);
----
2	7	17

statement ok
CREATE TABLE rec_rr AS
SELECT r.source_hash AS doc_hash,
       struct_insert(r,
           external_ids := (SELECT list(e ORDER BY e.rowid) FROM src_rr_ids e JOIN rr_id_item m ON m.rid = e.rowid
                            WHERE e.source_hash = r.source_hash AND m.item = 0),
           resource_items := (SELECT list(struct_insert(i,
                                     external_ids := (SELECT list(e ORDER BY e.rowid) FROM src_rr_ids e JOIN rr_id_item m ON m.rid = e.rowid
                                                      WHERE e.source_hash = i.source_hash AND m.item = i.ordinal)) ORDER BY i.ordinal)
                              FROM src_rr_items i WHERE i.source_hash = r.source_hash)) AS rec
FROM src_rr r;

statement ok
CREATE TABLE out_rr AS SELECT doc_hash, orcid_research_resource_to_xml(rec) AS xml, orcid_research_resource_to_json(rec) AS json FROM rec_rr;

query I
SELECT sum(n)::BIGINT FROM (
  (SELECT count(*) AS n FROM (SELECT * EXCLUDE (source_hash) FROM src_rr EXCEPT ALL SELECT r.* EXCLUDE (source_hash) FROM out_rr o, orcid_research_resources_xml(o.xml) r))
  UNION ALL
  (SELECT count(*) AS n FROM (SELECT r.* EXCLUDE (source_hash) FROM out_rr o, orcid_research_resources_xml(o.xml) r EXCEPT ALL SELECT * EXCLUDE (source_hash) FROM src_rr))
  UNION ALL
  (SELECT count(*) AS n FROM (SELECT * EXCLUDE (source_hash) FROM src_rr EXCEPT ALL SELECT r.* EXCLUDE (source_hash) FROM out_rr o, orcid_research_resources_json(o.json) r))
  UNION ALL
  (SELECT count(*) AS n FROM (SELECT r.* EXCLUDE (source_hash) FROM out_rr o, orcid_research_resources_json(o.json) r EXCEPT ALL SELECT * EXCLUDE (source_hash) FROM src_rr))
  UNION ALL
  (SELECT count(*) AS n FROM (SELECT * EXCLUDE (source_hash) FROM src_rr_items EXCEPT ALL SELECT i.* EXCLUDE (source_hash) FROM out_rr o, orcid_research_resource_items_xml(o.xml) i))
  UNION ALL
  (SELECT count(*) AS n FROM (SELECT i.* EXCLUDE (source_hash) FROM out_rr o, orcid_research_resource_items_xml(o.xml) i EXCEPT ALL SELECT * EXCLUDE (source_hash) FROM src_rr_items))
  UNION ALL
  (SELECT count(*) AS n FROM (SELECT * EXCLUDE (source_hash) FROM src_rr_items EXCEPT ALL SELECT i.* EXCLUDE (source_hash) FROM out_rr o, orcid_research_resource_items_json(o.json) i))
  UNION ALL
  (SELECT count(*) AS n FROM (SELECT i.* EXCLUDE (source_hash) FROM out_rr o, orcid_research_resource_items_json(o.json) i EXCEPT ALL SELECT * EXCLUDE (source_hash) FROM src_rr_items))
  UNION ALL
  (SELECT count(*) AS n FROM (SELECT * EXCLUDE (source_hash) FROM src_rr_ids EXCEPT ALL SELECT e.* EXCLUDE (source_hash) FROM out_rr o, orcid_external_ids_xml(o.xml) e))
  UNION ALL
  (SELECT count(*) AS n FROM (SELECT e.* EXCLUDE (source_hash) FROM out_rr o, orcid_external_ids_xml(o.xml) e EXCEPT ALL SELECT * EXCLUDE (source_hash) FROM src_rr_ids))
  UNION ALL
  (SELECT count(*) AS n FROM (SELECT * EXCLUDE (source_hash) FROM src_rr_ids EXCEPT ALL SELECT e.* EXCLUDE (source_hash) FROM out_rr o, orcid_external_ids_json(o.json) e))
  UNION ALL
  (SELECT count(*) AS n FROM (SELECT e.* EXCLUDE (source_hash) FROM out_rr o, orcid_external_ids_json(o.json) e EXCEPT ALL SELECT * EXCLUDE (source_hash) FROM src_rr_ids)));
----
0

# research-resource-3.0.xsd order: proposal before resource-items; the JSON has no resource-items member
query III
SELECT position('<research-resource:proposal>' IN xml) < position('<research-resource:resource-items>' IN xml),
       contains(json, '"resource-item": [') AND NOT contains(json, '"resource-items"'),
       contains(json, '"hosts": {' || chr(10) || '      "organization": [')
FROM out_rr WHERE doc_hash = (SELECT sha256(doc) FROM docs WHERE name = 'research-resource-3.0.xml');
----
true	true	true

# ---------------------------------------------------------------- research resource: every host (CROSSCHECK #9)
# With `hosts` lists (rows of
# orcid_research_resource_hosts, for the proposal and for each item) every host
# is written: the XML write sample has one host per proposal and item (1 + 2),
# the JSON one two proposal hosts (ORCID, NASA) and one per item (2 + 5; python3
# -I, proposal.hosts.organization and resource-item[i].hosts.organization). The
# flat first-host fields of the same rows agree with the lists, so both are given.

statement ok
CREATE TABLE src_rr_hosts AS
SELECT h.* FROM (SELECT doc FROM docs WHERE name LIKE 'research-resource-%' AND format = 'xml') d, orcid_research_resource_hosts_xml(d.doc) h
UNION ALL
SELECT h.* FROM (SELECT doc FROM docs WHERE name LIKE 'research-resource-%' AND format = 'json') d, orcid_research_resource_hosts_json(d.doc) h;

query III
SELECT count(*), count(*) FILTER (WHERE container = 'proposal'), string_agg(host_name, ',' ORDER BY host_name) FILTER (WHERE container = 'proposal')
FROM src_rr_hosts;
----
10	3	NASA,ORCID,ORCID

statement ok
CREATE TABLE rec_rr_hosts AS
SELECT r.source_hash AS doc_hash,
       struct_insert(r,
           external_ids := (SELECT list(e ORDER BY e.rowid) FROM src_rr_ids e JOIN rr_id_item m ON m.rid = e.rowid
                            WHERE e.source_hash = r.source_hash AND m.item = 0),
           hosts := (SELECT list(h ORDER BY h.ordinal) FROM src_rr_hosts h
                     WHERE h.source_hash = r.source_hash AND h.container = 'proposal'),
           resource_items := (SELECT list(struct_insert(i,
                                     external_ids := (SELECT list(e ORDER BY e.rowid) FROM src_rr_ids e JOIN rr_id_item m ON m.rid = e.rowid
                                                      WHERE e.source_hash = i.source_hash AND m.item = i.ordinal),
                                     hosts := (SELECT list(h ORDER BY h.ordinal) FROM src_rr_hosts h
                                               WHERE h.source_hash = i.source_hash AND h.container = 'resource-item'
                                                 AND h.item_ordinal = i.ordinal)) ORDER BY i.ordinal)
                              FROM src_rr_items i WHERE i.source_hash = r.source_hash)) AS rec
FROM src_rr r;

statement ok
CREATE TABLE out_rr_hosts AS SELECT doc_hash, orcid_research_resource_to_xml(rec) AS xml, orcid_research_resource_to_json(rec) AS json FROM rec_rr_hosts;

# every host reads back, in XML and in JSON; the other rows are as before
query I
SELECT sum(n)::BIGINT FROM (
  (SELECT count(*) AS n FROM (SELECT * EXCLUDE (source_hash) FROM src_rr_hosts EXCEPT ALL SELECT h.* EXCLUDE (source_hash) FROM out_rr_hosts o, orcid_research_resource_hosts_xml(o.xml) h))
  UNION ALL
  (SELECT count(*) AS n FROM (SELECT h.* EXCLUDE (source_hash) FROM out_rr_hosts o, orcid_research_resource_hosts_xml(o.xml) h EXCEPT ALL SELECT * EXCLUDE (source_hash) FROM src_rr_hosts))
  UNION ALL
  (SELECT count(*) AS n FROM (SELECT * EXCLUDE (source_hash) FROM src_rr_hosts EXCEPT ALL SELECT h.* EXCLUDE (source_hash) FROM out_rr_hosts o, orcid_research_resource_hosts_json(o.json) h))
  UNION ALL
  (SELECT count(*) AS n FROM (SELECT h.* EXCLUDE (source_hash) FROM out_rr_hosts o, orcid_research_resource_hosts_json(o.json) h EXCEPT ALL SELECT * EXCLUDE (source_hash) FROM src_rr_hosts))
  UNION ALL
  (SELECT count(*) AS n FROM (SELECT * EXCLUDE (source_hash) FROM src_rr EXCEPT ALL SELECT r.* EXCLUDE (source_hash) FROM out_rr_hosts o, orcid_research_resources_xml(o.xml) r))
  UNION ALL
  (SELECT count(*) AS n FROM (SELECT * EXCLUDE (source_hash) FROM src_rr_items EXCEPT ALL SELECT i.* EXCLUDE (source_hash) FROM out_rr_hosts o, orcid_research_resource_items_json(o.json) i)));
----
0

# without the lists the flat fields still write the first host only (the
# rec_rr round trip above): the JSON proposal keeps ORCID and loses NASA
query II
SELECT (SELECT count(*) FROM out_rr o, orcid_research_resource_hosts_json(o.json) h WHERE h.container = 'proposal'),
       (SELECT count(*) FROM out_rr_hosts o, orcid_research_resource_hosts_json(o.json) h WHERE h.container = 'proposal');
----
2	3

# flat fields that disagree with the list are an error, for the proposal and for an item
statement error
SELECT orcid_research_resource_to_xml({'title': 'T', 'host_name': 'A', 'hosts': [{'host_name': 'B'}],
    'resource_items': [{'resource_name': 'N', 'resource_type': 'equipment', 'host_name': 'H'}]});
----
research_resource: 'host_name' is 'A', but the first 'hosts[].host_name' is 'B'

statement error
SELECT orcid_research_resource_to_xml({'title': 'T', 'host_name': 'A',
    'resource_items': [{'resource_name': 'N', 'resource_type': 'equipment', 'host_city': 'X', 'hosts': [{'host_name': 'H', 'host_city': NULL}]}]});
----
research_resource: 'resource_items[1].host_city' is 'X', but the first 'resource_items[1].hosts[].host_city' is absent

# agreeing fields are fine: the first non-empty value per field, as the readers fill them
statement ok
CREATE TABLE rr_agree AS
SELECT orcid_research_resource_to_xml({'title': 'T', 'host_name': 'A', 'host_country': 'US',
    'hosts': [{'host_name': 'A', 'host_country': NULL}, {'host_name': 'B', 'host_country': 'US'}],
    'resource_items': [{'resource_name': 'N', 'resource_type': 'equipment', 'hosts': [{'host_name': 'H', 'host_country': NULL}]}]}) AS x;

query III
SELECT count(*), string_agg(h.host_name, ',' ORDER BY h.container, h.item_ordinal, h.ordinal),
       string_agg(coalesce(h.host_country, '-'), ',' ORDER BY h.container, h.item_ordinal, h.ordinal)
FROM rr_agree t, orcid_research_resource_hosts_xml(t.x) h;
----
3	A,B,H	-,US,-

query II
SELECT r.host_name, r.host_country FROM rr_agree t, orcid_research_resources_xml(t.x) r;
----
A	US

