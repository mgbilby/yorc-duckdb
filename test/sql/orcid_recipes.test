# ---------------------------------------------------------------- 17. write a work as an ORCID document

query IIIIII
SELECT w.title, w.journal, w.pub_year, w.pub_month, w.doi, c.credit_name || '/' || c.sequence || '/' || c.role
FROM (SELECT orcid_work_to_json({
    'title': 'Hydrothermal vent communities', 'type': 'journal-article',
    'journal': 'Deep-Sea Research', 'pub_year': 2024, 'pub_month': 3,
    'external_ids': [{'type': 'doi', 'value': '10.1234/vents.2024', 'relationship': 'self'}],
    'contributors': [{'credit_name': 'A. Researcher', 'sequence': 'first', 'role': 'author'}]}) AS body) b,
     orcid_works_json(b.body) w, orcid_contributors_json(b.body) c;
----
Hydrothermal vent communities	Deep-Sea Research	2024	3	10.1234/vents.2024	A. Researcher/first/author

# test/data/activities/...30089981.xml: put-code 30089981, type other, year 2014, one DOI
# (10.6084/M9.FIGSHARE.1119230), one contributor (Henry Rzepa)
query IIIIII
WITH w AS (SELECT * FROM orcid_works('test/data/activities/0000-0002-8635-8390_works_30089981.xml')),
     x AS (SELECT orcid_work_to_xml(struct_insert(w,
             external_ids := (SELECT list(e) FROM orcid_external_ids('test/data/activities/0000-0002-8635-8390_works_30089981.xml') e
                              WHERE e.owner_put_code = w.put_code),
             contributors := (SELECT list(c ORDER BY c.ordinal)
                              FROM orcid_contributors('test/data/activities/0000-0002-8635-8390_works_30089981.xml') c
                              WHERE c.owner_put_code = w.put_code))) AS doc
           FROM w)
SELECT r.put_code, r.type, r.pub_year, r.doi, (SELECT min(credit_name) FROM orcid_contributors_xml((SELECT doc FROM x))),
       r.title = (SELECT title FROM w)
FROM orcid_works_xml((SELECT doc FROM x)) r;
----
30089981	other	2014	10.6084/m9.figshare.1119230	Henry Rzepa	true

# ---------------------------------------------------------------- 18. bulk documents
# D has 12 works (grep -c '<work:work-summary'), with distinct put-codes: one batch

query III
WITH w AS (SELECT * FROM orcid_works('test/data/demo/0000-0002-2771-9344.xml')),
     b AS (SELECT put_code, (row_number() OVER (ORDER BY put_code) - 1) // 100 AS batch FROM w),
     out AS (SELECT b.batch, count(*) AS works, orcid_bulk_works_to_json(list(w ORDER BY w.put_code)) AS body
             FROM w JOIN b USING (put_code)
             GROUP BY b.batch ORDER BY b.batch)
SELECT string_agg(works::VARCHAR, ',' ORDER BY batch),
       (SELECT count(*) FROM out o, orcid_works_json(o.body) r),
       (SELECT count(DISTINCT r.put_code) FROM out o, orcid_works_json(o.body) r)
FROM out;
----
12	12	12

# ---------------------------------------------------------------- 19. XML <-> JSON

query I
SELECT count(*) FROM (
  SELECT * EXCLUDE (source_hash) FROM orcid_works('reference/orcid-model/record_3.0/samples/write_samples/work-full-3.0.xml')
  EXCEPT
  SELECT j.* EXCLUDE (source_hash)
  FROM (SELECT orcid_work_to_json(struct_insert(w,
          external_ids := (SELECT list(e) FROM orcid_external_ids('reference/orcid-model/record_3.0/samples/write_samples/work-full-3.0.xml') e),
          contributors := (SELECT list(c ORDER BY c.ordinal) FROM orcid_contributors('reference/orcid-model/record_3.0/samples/write_samples/work-full-3.0.xml') c))) AS body
        FROM orcid_works('reference/orcid-model/record_3.0/samples/write_samples/work-full-3.0.xml') w) d,
       orcid_works_json(d.body) j);
----
0

query II
SELECT starts_with(x, '<?xml version="1.0" encoding="UTF-8"?>' || chr(10) || '<employment:employment '),
       (SELECT org_name FROM orcid_affiliations_xml(x))
FROM (SELECT orcid_affiliation_to_xml(struct_insert(a,
         external_ids := (SELECT list(e) FROM orcid_external_ids('reference/orcid-model/record_3.0/samples/write_samples/employment-3.0.json',
                                                                 json_root := 'employment') e))) AS x
      FROM orcid_affiliations('reference/orcid-model/record_3.0/samples/write_samples/employment-3.0.json', json_root := 'employment') a);
----
true	Boston University
