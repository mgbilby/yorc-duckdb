# 4.8 record-3.0.xml person/name and biography
query IIII
SELECT given_names, family_name, credit_name, biography
FROM orcid_person('reference/orcid-model/record_3.0/samples/read_samples/record-3.0.xml');
----
give-names	family-name	credit-name	biography

# 4.9 record-3.0.xml: one item of each of the six person-item kinds
query I
SELECT string_agg(kind || '=' || value, ',' ORDER BY kind)
FROM (SELECT kind, value, url, type, visibility
      FROM orcid_person_items('reference/orcid-model/record_3.0/samples/read_samples/record-3.0.xml'));
----
address=US,email=user1@email.com,external-identifier=value-1,keyword=keyword1,other-name=other-name-1,researcher-url=url-name-1

# 4.10 history-3.0.xml
query IIII
SELECT creation_method, claimed, verified_email, visibility
FROM orcid_history('reference/orcid-model/record_3.0/samples/read_samples/history-3.0.xml');
----
API	true	true	private

# ---------------------------------------------------------------- 5.1 works, contributors, external ids

query IIIIII
WITH w AS (SELECT * FROM orcid_works('reference/orcid-model/record_3.0/samples/read_samples/work-full-3.0.xml')),
     c AS (SELECT * FROM orcid_contributors('reference/orcid-model/record_3.0/samples/read_samples/work-full-3.0.xml')),
     e AS (SELECT * FROM orcid_external_ids('reference/orcid-model/record_3.0/samples/read_samples/work-full-3.0.xml'))
SELECT w.put_code, w.title, c.credit_name, c.role, e.type AS id_type, e.value AS id_value
FROM w
LEFT JOIN c ON c.source_hash = w.source_hash AND c.owner_put_code = w.put_code
LEFT JOIN e ON e.source_hash = w.source_hash AND e.owner_put_code = w.put_code
ORDER BY e.type;
----
123	common:title	work:credit-name	author	agr	work:external-identifier-id
123	common:title	work:credit-name	author	doi	work:doi

# the same join over the synthetic bulk response, whose documents carry no root path:
# 2 works x (3 + 3 contributors) x (1 + 2 external ids) = 3 + 6 rows
query II
WITH w AS (SELECT * FROM orcid_works('test/data/synthetic/coauthors-bulk.xml')),
     c AS (SELECT * FROM orcid_contributors('test/data/synthetic/coauthors-bulk.xml')),
     e AS (SELECT * FROM orcid_external_ids('test/data/synthetic/coauthors-bulk.xml'))
SELECT w.put_code, count(*)
FROM w
LEFT JOIN c ON c.source_hash = w.source_hash AND c.owner_put_code = w.put_code
LEFT JOIN e ON e.source_hash = w.source_hash AND e.owner_put_code = w.put_code
GROUP BY w.put_code ORDER BY w.put_code;
----
101	3
102	6

# ---------------------------------------------------------------- 5.2 affiliation timeline
# S has one <employment:employment-summary>: start 1948-02-02, end-date year 2025
# (as recipe 4.3), so none is current

query IIIII
SELECT count(*), count(*) FILTER (WHERE is_current), min(start_year), max(start_year),
       min(start_year) FILTER (WHERE is_current)
FROM (SELECT affiliation_type, org_name, role_title, start_year, end_year, end_year IS NULL AS is_current
      FROM orcid_affiliations('reference/orcid-model/record_3.0/samples/read_samples/record-3.0.xml')
      WHERE affiliation_type = 'employment'
      ORDER BY start_year, end_year NULLS LAST);
----
1	0	1948	1948	NULL

# ---------------------------------------------------------------- 5.3 funding by funder
# S's one <funding:funding-summary>: organization name common:name, FUNDREF

query II
SELECT funder, fundings
FROM (SELECT org_name AS funder, org_disambiguation_source, org_disambiguated_id,
             count(*) AS fundings, min(start_year) AS first_year, max(end_year) AS last_year
      FROM orcid_fundings('reference/orcid-model/record_3.0/samples/read_samples/record-3.0.xml')
      GROUP BY ALL)
ORDER BY fundings DESC, funder;
----
common:name	1

# ---------------------------------------------------------------- 6. DOIs and duplicates
# python3 -I (xml.etree) over D: first external-id with type doi and relationship
# self in each work-summary, lowercased: 12 DOIs, 11 distinct;
# 10.25592/uhhfdm.19102 by 2 works (224052943, 224052945), both in work group 1

query IIII
SELECT count(*), max(works), count(*) FILTER (WHERE groups > 1), sum(works)
FROM (SELECT doi, count(*) AS works, count(DISTINCT group_index) AS groups, list(put_code ORDER BY put_code) AS put_codes
      FROM orcid_works('test/data/demo/0000-0002-2771-9344.xml')
      WHERE doi IS NOT NULL
      GROUP BY doi
      HAVING count(*) > 1);
----
1	2	0	2

query III
SELECT doi, works, groups
FROM (SELECT doi, count(*) AS works, count(DISTINCT group_index) AS groups
      FROM orcid_works('test/data/demo/0000-0002-2771-9344.xml')
      WHERE doi IS NOT NULL GROUP BY doi HAVING count(*) > 1)
ORDER BY works DESC, doi LIMIT 1;
----
10.25592/uhhfdm.19102	2	1

# ---------------------------------------------------------------- 7. co-author pairs
# test/data/synthetic/coauthors-bulk.xml: work 101 lists 0000-0002-1825-0097,
# 0000-0001-5109-3700 and one contributor without an iD; work 102 lists
# 0000-0001-5109-3700, 0000-0002-1694-233X and 0000-0002-1825-0097

query III
WITH c AS (
  SELECT DISTINCT source_hash, owner, owner_put_code, contributor_orcid
  FROM orcid_contributors('test/data/synthetic/coauthors-bulk.xml')
  WHERE contributor_orcid IS NOT NULL)
SELECT a.contributor_orcid AS orcid_a, b.contributor_orcid AS orcid_b, count(*) AS works
FROM c a
JOIN c b ON a.source_hash = b.source_hash AND a.owner = b.owner AND a.owner_put_code = b.owner_put_code
        AND a.contributor_orcid < b.contributor_orcid
GROUP BY ALL
ORDER BY works DESC, orcid_a, orcid_b;
----
0000-0001-5109-3700	0000-0002-1825-0097	2
0000-0001-5109-3700	0000-0002-1694-233X	1
0000-0002-1694-233X	0000-0002-1825-0097	1

# ---------------------------------------------------------------- 8. institutions
# S: disambiguation-source inside the seven affiliation summaries: GRID for
# distinction, education, employment, invited-position; RINGGOLD for
# membership, qualification, service (each with its own identifier)

query II
SELECT source, sum(affiliations)
FROM (SELECT org_disambiguation_source AS source, org_disambiguated_id AS id,
             any_value(org_name) AS name, count(DISTINCT orcid) AS people, count(*) AS affiliations
      FROM orcid_affiliations('reference/orcid-model/record_3.0/samples/read_samples/record-3.0.xml')
      WHERE org_disambiguated_id IS NOT NULL
      GROUP BY ALL)
GROUP BY source ORDER BY source;
----
GRID	4
RINGGOLD	3

# ---------------------------------------------------------------- 9. timeline
