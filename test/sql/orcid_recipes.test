distinction	distinction-org	distinction:role-title	1948	1948
education	education-org	education:role-title	1948	2019
employment	employment-org	employment:role-title	1948	2025
invited-position	invited-position-org	invited-position:role-title	2019	2025
membership	membership-org	membership:role-title	1948	NULL
qualification	qualification-org	qualification:role-title	1948	2025
service	service-org	service:role-title	1948	NULL

# 4.4 peer-review-full-3.0.xml: review-completion-date/year 1948 (the 'or' path), convening-organization common:name
query IIIIII
SELECT reviewer_role, review_type, completion_year, subject_type, subject_name, convening_org_name
FROM orcid_peer_reviews('reference/orcid-model/record_3.0/samples/read_samples/peer-review-full-3.0.xml');
