query II
SELECT count(*), count(*) FILTER (WHERE event = 'created')
FROM orcid_timeline('test/data/synthetic/coauthors-bulk.xml');
----
3	2

query I
SELECT count(*)
FROM (SELECT event_at::TIMESTAMPTZ AS event_at, event, kind, put_code, label
      FROM orcid_timeline('test/data/demo/0000-0002-2771-9344.xml')
      ORDER BY event_at LIMIT 10);
