# ---------------------------------------------------------------- 13. export
# (parquet: required at the top of the file)

statement ok
COPY (SELECT * FROM orcid_works('test/data/*.xml')) TO '__TEST_DIR__/recipes_works.parquet' (FORMAT parquet);

statement ok
COPY (SELECT orcid, put_code, title, pub_year, doi FROM orcid_works('test/data/*.xml'))
  TO '__TEST_DIR__/recipes_works.csv' (HEADER, DELIMITER ',');

query III
SELECT (SELECT count(*) FROM read_parquet('__TEST_DIR__/recipes_works.parquet')),
       (SELECT count(*) FROM read_csv('__TEST_DIR__/recipes_works.csv')),
       (SELECT count(*) FROM (DESCRIBE SELECT * FROM read_parquet('__TEST_DIR__/recipes_works.parquet')));
----
382	382	32

