# name: test/sql/orcid_recipes.test
# description: the fixture-runnable recipes of docs/RECIPES.md (numbers in the comments); expected values from grep/awk/inspection of the fixtures, each stated
# group: [orcid]
#
# On a failure, fix the expectation, not the recipe, only after checking the
# fixture by hand.
#
# Not here: 3.5 (needs the network), 6 second query and 13 third query (need a
# full dump), 15 (DuckDB v2.0 only).
#
# F = test/data/0000-0003-0100-6634.xml, the only record directly in test/data
# (the test/data/*.xml globs); D = test/data/demo/0000-0002-2771-9344.xml, the
# record the recipes name; S = ORCID's sample record
# reference/orcid-model/record_3.0/samples/read_samples/record-3.0.xml, for the
# recipes about affiliations and fundings, which D does not have. All three are
# pretty-printed, one element per line, so grep -c counts elements.

require yorc

require parquet

# ---------------------------------------------------------------- 2. iDs

query III
SELECT orcid_normalize('https://orcid.org/0000-0002-1825-0097'),
       orcid_normalize(' 000000021694233x '),
       orcid_valid('0000-0002-1825-0098');
----
0000-0002-1825-0097	0000-0002-1694-233X	false

# id.cpp NormalizeId skips '-' and whitespace after the prefix; 'www.' is not a prefix
query III
SELECT raw, orcid_normalize(raw) AS orcid, orcid_valid(raw) AS valid
FROM (VALUES ('https://orcid.org/0000-0002-1825-0097'),
             ('0000 0002 1825 0097'),
             ('0000-0002-1825-0098'),
             ('https://www.orcid.org/0000-0002-1825-0097')) t(raw)
ORDER BY raw;
----
0000 0002 1825 0097	0000-0002-1825-0097	true
0000-0002-1825-0098	NULL	false
https://orcid.org/0000-0002-1825-0097	0000-0002-1825-0097	true
https://www.orcid.org/0000-0002-1825-0097	NULL	false

# ---------------------------------------------------------------- 3.1 one record
# python3 -I (xml.etree) over D: put-code and publication-date/year of each
# <work:work-summary>, sorted by year desc, put-code asc; every work has a year
# (12 of 12): the three of 2026, then 37069489 and 43318438 of 2017

query I
SELECT list(put_code ORDER BY put_code)
FROM (SELECT put_code, title, type, pub_year, doi
      FROM orcid_works('test/data/demo/0000-0002-2771-9344.xml')
      ORDER BY pub_year DESC, put_code
      LIMIT 5);
----
[37069489, 43318438, 224052943, 224052944, 224052945]

# ---------------------------------------------------------------- 3.2 directory, glob
# grep -c '<work:work-summary' F = 382; one level down: activities/ 1 <work:work>,
# changes/old.xml 1 and new.xml 1 <work:work-summary>, demo/ (D) 12 <work:work-summary>,
# errors/ 0, synthetic/ 2 <work:work>

query II
SELECT count(*), count(DISTINCT orcid) FROM orcid_works('test/data/*.xml');
----
382	1

query I
SELECT count(*) FROM orcid_works('test/data/*/*.xml');
----
17

# ---------------------------------------------------------------- 3.3 XML in a table
# grep -c on F: 18 employment + 9 education + 7 distinction + 16 membership + 29 service summaries

statement ok
CREATE TABLE records AS
SELECT regexp_extract(filename, '([0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X])', 1) AS orcid,
       content AS xml
FROM read_text('test/data/*.xml');

query II
SELECT count(*), count(DISTINCT r.orcid)
FROM (SELECT r.orcid, a.affiliation_type, a.org_name, a.start_year FROM records r, orcid_affiliations_xml(r.xml) a) r;
----
79	1

statement ok
CREATE TABLE works_empty AS SELECT * FROM orcid_works_xml(NULL);

query II
SELECT (SELECT count(*) FROM works_empty), (SELECT count(*) FROM (DESCRIBE works_empty));
----
0	32

# ---------------------------------------------------------------- 3.4 an archive in place
# tar -tvzf test/data/dump/orcid_test_summaries.tar.gz: three .xml members; the
# third's path holds 0000-0000-0000-0000, whose MOD 11-2 check character is 1, so no iD

query III
SELECT orcid, given_names, family_name
FROM orcid_person('test/data/dump/orcid_test_summaries.tar.gz')
ORDER BY orcid;
----
0000-0003-0100-6634	Mark	Bilby
8888-8888-8888-8880	give-names	family-name

query III
SELECT count(*), count(orcid), count(*) FILTER (WHERE length(xml) > 0)
FROM (SELECT member, orcid, xml FROM orcid_documents('test/data/dump/orcid_test_summaries.tar.gz'));
----
3	2	3

# ---------------------------------------------------------------- 3.6 named parameters
# member sizes from tar -tvzf: the 634 member (382 works) is 1,324,198 bytes and comes first

query II
SELECT count(*), min(orcid)
FROM orcid_works('test/data/dump/orcid_test_summaries.tar.gz', members := '*/634/*');
----
382	0000-0003-0100-6634

query I
SELECT count(*) FROM orcid_works('test/data/dump/orcid_test_summaries.tar.gz', max_records := 1);
----
382

statement error
SELECT count(*) FROM orcid_works('test/data/dump/orcid_test_summaries.tar.gz', max_member_bytes := 1000);
----
over max_member_bytes (1000)

# ---------------------------------------------------------------- 3.7 a reproducible sample of a dump
# the fixture's two records, in archive order; seed 42
# draws below(2) = 1, so capacity 1 keeps the first (orcid_dump_sample.test)
query III
SELECT slot, orcid, eligible FROM orcid_dump_sample('test/data/dump/orcid_test_summaries.tar.gz', 1, 42);
----
0	0000-0003-0100-6634	2

# works per sampled record: 382 in the fixture record, 1 in 8888-8888-8888-8880
# (the dump's 386 works less the 3 of the works document)
query II
SELECT s.orcid, count(*) AS works
FROM orcid_dump_sample('test/data/dump/orcid_test_summaries.tar.gz', 5, 42) s, orcid_works_xml(s.xml) w
GROUP BY s.orcid ORDER BY s.orcid;
----
0000-0003-0100-6634	382
8888-8888-8888-8880	1

# ---------------------------------------------------------------- 4. one query per section
# values read off the reference/orcid-model samples named in each query

# 4.1 work-full-3.0.xml: put-code="123", <work:type>artistic-performance, year 1948, doi/self 'work:doi'
query IIIIII
SELECT put_code, title, type, pub_year, doi, item
FROM orcid_works('reference/orcid-model/record_3.0/samples/read_samples/work-full-3.0.xml');
----
123	common:title	artistic-performance	1948	work:doi	work

# 4.2 funding-full-3.0.xml: <funding:type>grant, <funding:amount currency-code="ADP">1234, organization common:name / FUNDREF
query IIIIII
SELECT title, type, amount, currency, org_name, org_disambiguation_source
FROM orcid_fundings('reference/orcid-model/record_3.0/samples/read_samples/funding-full-3.0.xml');
----
common:title	grant	1234	ADP	common:name	FUNDREF

# 4.3 record-3.0.xml: one summary of each type; start/end years by awk over its start-date / end-date blocks
query IIIII
SELECT affiliation_type, org_name, role_title, start_year, end_year
FROM orcid_affiliations('reference/orcid-model/record_3.0/samples/read_samples/record-3.0.xml')
ORDER BY affiliation_type;
