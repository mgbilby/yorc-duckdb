# the iD-prefix form: tar -tzf lists */000/ members 2759-4000 and 6715-4000 in 2024,
# 5739-7000 and 6715-4000 in 2025: 2759-4000 removed (6 rows), 5739-7000 added
# (5 rows), 6715-4000 one modified work (the rows of orcid_docs_examples.test)
query II
SELECT count(*), count(DISTINCT orcid)
FROM task_release_changes('test/data/releases/ORCID_2024_10_summaries.tar.gz',
                          'test/data/releases/ORCID_2025_10_summaries.tar.gz', '*/000/*');
----
