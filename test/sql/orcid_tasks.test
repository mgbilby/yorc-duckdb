# ---------------------------------------------------------------- affiliation-timeline

# BEGIN examples/tasks/affiliation-timeline.sql

statement ok
CREATE OR REPLACE MACRO task_affiliation_timeline(path) AS TABLE
    SELECT orcid, affiliation_type, org_name, role_title, department,
           start_year, end_year,
           end_year - start_year AS years,
           end_year IS NULL AND affiliation_type <> 'distinction' AS is_current
    FROM orcid_affiliations(path)
    ORDER BY orcid, start_year NULLS LAST, end_year NULLS LAST, affiliation_type, put_code;

statement ok
CREATE OR REPLACE MACRO task_affiliation_current(path) AS TABLE
    SELECT * FROM task_affiliation_timeline(path)
    WHERE is_current;

# END examples/tasks/affiliation-timeline.sql

# F, awk over the five affiliation types' summaries: summaries without an
# end-date year: distinction 7 (never current), education 1, employment 1,
# membership 4, service 1
query II
SELECT count(*), count(*) FILTER (WHERE is_current)
FROM task_affiliation_timeline('test/data/0000-0003-0100-6634.xml');
----
79	7

query II
SELECT affiliation_type, count(*) FROM task_affiliation_current('test/data/0000-0003-0100-6634.xml')
GROUP BY ALL ORDER BY affiliation_type;
----
education	1
employment	1
membership	4
service	1

# record-3.0.xml sample: the timeline starts with the 1948 starts; invited-position starts 2019
query III
SELECT affiliation_type, start_year, is_current
FROM task_affiliation_timeline('reference/orcid-model/record_3.0/samples/read_samples/record-3.0.xml')
WHERE affiliation_type IN ('invited-position', 'membership', 'distinction')
ORDER BY affiliation_type;
----
distinction	1948	false
invited-position	2019	false
membership	1948	true

# ---------------------------------------------------------------- release-changes

# BEGIN examples/tasks/release-changes.sql

statement ok
CREATE OR REPLACE MACRO task_release_changes(old_path, new_path, members) AS TABLE
    WITH pairs AS (
        SELECT orcid, a.xml AS old_xml, b.xml AS new_xml
        FROM orcid_documents(old_path, members := members) a
        FULL JOIN orcid_documents(new_path, members := members) b USING (orcid))
    SELECT c.*
    FROM pairs p, orcid_changes_xml(p.old_xml, p.new_xml) c;

statement ok
CREATE OR REPLACE MACRO task_release_change_summary(old_path, new_path, members) AS TABLE
    SELECT section, change, count(*) AS items, count(DISTINCT orcid) AS records
    FROM task_release_changes(old_path, new_path, members)
    GROUP BY ALL
    ORDER BY section, change;

# END examples/tasks/release-changes.sql

# the 16 rows of orcid_docs_examples.test ("Comparing two releases"), tallied
query IIII
SELECT * FROM task_release_change_summary('test/data/releases/ORCID_2024_10_summaries.tar.gz',
                                          'test/data/releases/ORCID_2025_10_summaries.tar.gz', '*.xml')
ORDER BY section, change;
----
affiliations	added	1	1
affiliations	modified	1	1
affiliations	removed	2	1
history	added	1	1
history	removed	1	1
person	added	1	1
person	modified	1	1
person	removed	1	1
works	added	2	1
works	modified	2	2
works	removed	3	2

query II
SELECT count(*), count(DISTINCT orcid)
FROM task_release_changes('test/data/releases/ORCID_2024_10_summaries.tar.gz',
                          'test/data/releases/ORCID_2025_10_summaries.tar.gz', '*.xml');
----
