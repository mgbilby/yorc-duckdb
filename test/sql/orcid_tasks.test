# 10.25592/uhhfdm.19102 is on 224052943 and 224052945, both in work group 1;
# no affiliations, no fundings (empty containers)
query IIIIIIIIIII
SELECT * FROM task_health_summary('test/data/demo/0000-0002-2771-9344.xml');
----
0000-0002-2771-9344	12	0	0	1	0	0	0	0	0	0

query III
