# ---------------------------------------------------------------- doi-dedupe

# BEGIN examples/tasks/doi-dedupe.sql

statement ok
CREATE OR REPLACE MACRO task_doi_duplicates(path) AS TABLE
    SELECT orcid, doi,
           count(*)                          AS works,
           count(DISTINCT group_index)       AS groups,
           list(put_code ORDER BY put_code)  AS put_codes
    FROM orcid_works(path)
    WHERE doi IS NOT NULL
    GROUP BY orcid, doi
    HAVING count(*) > 1
    ORDER BY works DESC, orcid, doi;

statement ok
CREATE OR REPLACE MACRO task_doi_cross_group(path) AS TABLE
    SELECT * FROM task_doi_duplicates(path)
    WHERE groups > 1;

statement ok
CREATE OR REPLACE MACRO task_doi_coclaims(path) AS TABLE
    SELECT doi,
           count(DISTINCT orcid)                       AS records,
           list_sort(list(DISTINCT orcid))             AS orcids
    FROM orcid_works(path)
    WHERE doi IS NOT NULL
    GROUP BY doi
    HAVING count(DISTINCT orcid) > 1
    ORDER BY records DESC, doi;

# END examples/tasks/doi-dedupe.sql

query IIIII
SELECT count(*), max(works), sum(works), count(*) FILTER (WHERE groups > 1), min(orcid)
FROM task_doi_duplicates('test/data/0000-0003-0100-6634.xml');
----
75	5	160	0	0000-0003-0100-6634

query III
SELECT doi, works, groups FROM task_doi_duplicates('test/data/0000-0003-0100-6634.xml') ORDER BY works DESC, doi LIMIT 1;
----
10.5281/zenodo.14674399	5	1

query I
SELECT count(*) FROM task_doi_cross_group('test/data/0000-0003-0100-6634.xml');
----
0

# one record only: nothing can be co-claimed
query I
SELECT count(*) FROM task_doi_coclaims('test/data/0000-0003-0100-6634.xml');
----
0

# ---------------------------------------------------------------- coauthors

# BEGIN examples/tasks/coauthors.sql

statement ok
CREATE OR REPLACE MACRO task_coauthor_pairs(path) AS TABLE
    WITH c AS (
        SELECT DISTINCT source_hash, owner, owner_put_code, contributor_orcid
        FROM orcid_contributors(path)
        WHERE contributor_orcid IS NOT NULL)
    SELECT a.contributor_orcid AS orcid_a,
           b.contributor_orcid AS orcid_b,
           count(*)            AS items
    FROM c a
    JOIN c b
      ON a.source_hash = b.source_hash AND a.owner = b.owner
     AND a.owner_put_code = b.owner_put_code
     AND a.contributor_orcid < b.contributor_orcid
    GROUP BY ALL
    ORDER BY items DESC, orcid_a, orcid_b;

statement ok
-- Per iD: how many distinct co-authors, over how many pair occurrences.
CREATE OR REPLACE MACRO task_coauthor_counts(path) AS TABLE
    WITH p AS (SELECT * FROM task_coauthor_pairs(path)),
    both_sides AS (
        SELECT orcid_a AS orcid, orcid_b AS other, items FROM p
        UNION ALL
        SELECT orcid_b, orcid_a, items FROM p)
    SELECT orcid, count(DISTINCT other) AS coauthors, sum(items) AS items
    FROM both_sides
    GROUP BY orcid
    ORDER BY coauthors DESC, orcid;

# END examples/tasks/coauthors.sql

# test/data/synthetic/coauthors-bulk.xml: work 101 lists 1825-0097 and 5109-3700
# (and a contributor without an iD); work 102 lists 5109-3700, 1694-233X, 1825-0097
query III
SELECT * FROM task_coauthor_pairs('test/data/synthetic/coauthors-bulk.xml') ORDER BY items DESC, orcid_a, orcid_b;
----
0000-0001-5109-3700	0000-0002-1825-0097	2
0000-0001-5109-3700	0000-0002-1694-233X	1
0000-0002-1694-233X	0000-0002-1825-0097	1

query III
SELECT * FROM task_coauthor_counts('test/data/synthetic/coauthors-bulk.xml') ORDER BY orcid;
----
0000-0001-5109-3700	2	3
0000-0002-1694-233X	2	2
0000-0002-1825-0097	2	3

# summaries list no contributors
query I
SELECT count(*) FROM task_coauthor_pairs('test/data/0000-0003-0100-6634.xml');
----
