# ---------------------------------------------------------------- the pre-3.0 peer-review layout (FINDINGS #3)
# read sample peer-reviews-3.0.xml nests its review in activities:group/peer-review:summary,
# a layout the v3.0 XSDs do not have. As in yorc-rs, yorc-zig and ORCID's classes, nothing
# inside it is read: the group's external id (orcid-generated:011484675699116) stays, and the
# summary's two (agr, doi) are not rows.

query II
SELECT count(*), string_agg(value, ',') FROM orcid_external_ids('reference/orcid-model/record_3.0/samples/read_samples/peer-reviews-3.0.xml');
----
1	orcid-generated:011484675699116

query I
SELECT count(*) FROM orcid_peer_reviews('reference/orcid-model/record_3.0/samples/read_samples/peer-reviews-3.0.xml');
----
0
