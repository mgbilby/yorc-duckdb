# name: test/sql/orcid_walkthrough.test
# description: docs/WALKTHROUGH.md and docs/walkthrough.sql: the walkthrough's cells stay in step with each other, and each cell's queries give the expected outputs of the page
# group: [orcid]
#
# On a failure, check the fixture by hand and then fix the page, the .sql file
# and this test together.
#
# The queries are the cells' queries, verbatim, with three differences:
# - the shell's dot commands (.print, .mode, .pager, .headers) are left out,
#   and LOAD yorc is `require orcid`;
# - the output file of cell 5 goes to __TEST_DIR__ instead of the current directory,
#   and printed documents and CSV lines are compared with newlines shown as \n;
# - where a cell's result is not derivable without running DuckDB (the
#   DuckDB version in cell 0),
#   the query runs as `statement ok` or is narrowed to the derivable columns.
# The expected values, and how each was derived (grep, tar, python3 -I over
# the input files), are in the HTML comment beside each "Expected output"
# block of docs/WALKTHROUGH.md.

require yorc

# ---------------------------------------------------------------- the page and the file are in step
# every SQL block marked <!-- cell N --> in WALKTHROUGH.md appears verbatim in
# walkthrough.sql, and the file prints exactly the 10 cell headings

query II
WITH md AS (
  SELECT unnest(regexp_extract_all(content, '(?s)<!-- cell [0-9]+ -->\n```sql\n(.*?)```', 1)) AS block
  FROM read_text('docs/WALKTHROUGH.md')),
     sq AS (SELECT content FROM read_text('docs/walkthrough.sql'))
SELECT count(*), count(*) FILTER (WHERE NOT contains(sq.content, md.block))
FROM md, sq;
----
10	0

query I
SELECT len(regexp_extract_all(content, '\.print "Cell [0-9]+\. '))
FROM read_text('docs/walkthrough.sql');
----
10

# ---------------------------------------------------------------- cell 0. setup
# version() is the running DuckDB's (v1.5.6 on the page), so it is not pinned

query II
SELECT extension_name, loaded
FROM (SELECT version() AS duckdb, extension_name, loaded
      FROM duckdb_extensions()
      WHERE extension_name = 'yorc');
----
yorc	true

