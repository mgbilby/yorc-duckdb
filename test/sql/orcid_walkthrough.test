statement ok
COPY works TO '__TEST_DIR__/walkthrough_works.csv' (HEADER, DELIMITER ',');

# the page prints these three lines with .mode list; newlines shown as \n here
query I
SELECT replace(x, chr(10), '\n')
FROM (SELECT array_to_string(string_split(content, chr(10))[1:3], chr(10)) FROM read_text('__TEST_DIR__/walkthrough_works.csv')) t(x);
