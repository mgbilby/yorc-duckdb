       (SELECT count(*) FROM orcid_fundings('reference/orcid-model/record_3.0/samples/read_samples/record-full-3.0.json')),
       (SELECT count(*) FROM orcid_affiliations('reference/orcid-model/record_3.0/samples/read_samples/record-full-3.0.json')),
       (SELECT count(*) FROM orcid_peer_reviews('reference/orcid-model/record_3.0/samples/read_samples/record-full-3.0.json')),
       (SELECT count(*) FROM orcid_research_resources('reference/orcid-model/record_3.0/samples/read_samples/record-full-3.0.json')),
       (SELECT count(*) FROM orcid_research_resource_items('reference/orcid-model/record_3.0/samples/read_samples/record-full-3.0.json')),
