# CROSSCHECK #14: ORCID's JSON has the Java enum
# names of history/creation-method ("MEMBER_REFERRED" above, python3 -I); the
# rows have the XSD values, as the XML gives them and yorc-rs reads them
# (creation_method_from_json): API, DIRECT, MEMBER_REFERRED, WEBSITE map,
# anything else (an XSD value, an unknown name) is kept.
query IIIIII
SELECT (SELECT creation_method FROM orcid_history_json('{"creation-method": "API", "claimed": true}', json_root := 'history')),
       (SELECT creation_method FROM orcid_history_json('{"creation-method": "DIRECT", "claimed": true}', json_root := 'history')),
       (SELECT creation_method FROM orcid_history_json('{"creation-method": "MEMBER_REFERRED", "claimed": true}', json_root := 'history')),
       (SELECT creation_method FROM orcid_history_json('{"creation-method": {"value": "WEBSITE"}, "claimed": true}', json_root := 'history')),
       (SELECT creation_method FROM orcid_history_json('{"creation-method": "Member-referred", "claimed": true}', json_root := 'history')),
       (SELECT creation_method FROM orcid_history_json('{"creation-method": "SOMETHING_NEW", "claimed": true}', json_root := 'history'));
----
API	Direct	Member-referred	website	Member-referred	SOMETHING_NEW

# CROSSCHECK #15: a person's JSON with sorted keys,
# as yorc-rs and yorc-zig write R/person-3.0.xml (one item of each kind,
# values from the XML by reading), gives person_items in the XSD order of
# person:person, the order of the XML read: other names, researcher URLs,
# emails, addresses, keywords, external identifiers.
query II
SELECT kind, value FROM orcid_person_items('reference/orcid-model/record_3.0/samples/read_samples/person-3.0.xml');
----
other-name	other-name-1
researcher-url	url-name-1
email	user1@email.com
address	US
keyword	keyword1
external-identifier	value-1

query II
SELECT kind, value FROM orcid_person_items_json('{
  "addresses": {"address": [{"country": {"value": "US"}, "put-code": 1, "visibility": "public"}]},
  "biography": {"content": "biography", "visibility": "public"},
  "emails": {"email": [{"email": "user1@email.com", "visibility": "public"}]},
  "external-identifiers": {"external-identifier": [{"external-id-type": "type-1", "external-id-url": {"value": "http://url.com/1"}, "external-id-value": "value-1", "put-code": 1, "visibility": "public"}]},
  "keywords": {"keyword": [{"content": "keyword1", "put-code": 1, "visibility": "public"}]},
  "name": {"credit-name": {"value": "credit-name"}, "family-name": {"value": "family-name"}, "given-names": {"value": "give-names"}},
  "other-names": {"other-name": [{"content": "other-name-1", "put-code": 1, "visibility": "public"}]},
  "researcher-urls": {"researcher-url": [{"put-code": 1248, "url": {"value": "http://url.com/"}, "url-name": "url-name-1", "visibility": "public"}]}
}', json_root := 'person');
----
other-name	other-name-1
researcher-url	url-name-1
email	user1@email.com
address	US
keyword	keyword1
external-identifier	value-1

# within a kind the array order stays; the kinds follow the XSD (sorted keys
# again: "keywords" before "other-names")
query II
SELECT kind, value FROM orcid_person_items_json('{
  "keywords": {"keyword": [{"content": "k2"}, {"content": "k1"}]},
  "other-names": {"other-name": [{"content": "o2"}, {"content": "o1"}]}
}', json_root := 'person');
----
other-name	o2
other-name	o1
keyword	k2
keyword	k1

# the same in a record: "activities-summary", "history", "orcid-identifier",
# "person" sorted; the person's items still come in XSD order
query II
SELECT kind, value FROM orcid_person_items_json('{
  "history": {"creation-method": "DIRECT"},
  "orcid-identifier": {"host": "orcid.org", "path": "0000-0002-1825-0097", "uri": "https://orcid.org/0000-0002-1825-0097"},
  "person": {"emails": {"email": [{"email": "a@example.org"}]}, "researcher-urls": {"researcher-url": [{"url": {"value": "http://example.org/"}, "url-name": "u"}]}}
}', json_root := 'record');
----
researcher-url	u
email	a@example.org

# CROSSCHECK #10: the assertion origin in every
# section with a common:source. python3 -I over record-full-3.0.json
# (source/assertion-origin-orcid/path per item): funding 5909; affiliations
# 9264-9270; peer review 2389; research resource 1498; work 178602; person
# items other-name 5813, address 3527, keyword 5097, external-identifier 3995;
# always "Three releasecandidate1" / 0000-0002-7319-2192, never a client id.
query IIIII
SELECT (SELECT string_agg(put_code::VARCHAR, ',' ORDER BY put_code) FROM orcid_fundings('reference/orcid-model/record_3.0/samples/read_samples/record-full-3.0.json') WHERE assertion_origin_orcid = '0000-0002-7319-2192'),
       (SELECT string_agg(put_code::VARCHAR, ',' ORDER BY put_code) FROM orcid_affiliations('reference/orcid-model/record_3.0/samples/read_samples/record-full-3.0.json') WHERE assertion_origin_orcid = '0000-0002-7319-2192'),
       (SELECT string_agg(put_code::VARCHAR, ',' ORDER BY put_code) FROM orcid_peer_reviews('reference/orcid-model/record_3.0/samples/read_samples/record-full-3.0.json') WHERE assertion_origin_orcid = '0000-0002-7319-2192'),
       (SELECT string_agg(put_code::VARCHAR, ',' ORDER BY put_code) FROM orcid_research_resources('reference/orcid-model/record_3.0/samples/read_samples/record-full-3.0.json') WHERE assertion_origin_orcid = '0000-0002-7319-2192'),
       (SELECT string_agg(kind || ':' || put_code, ',' ORDER BY put_code) FROM orcid_person_items('reference/orcid-model/record_3.0/samples/read_samples/record-full-3.0.json') WHERE assertion_origin_orcid = '0000-0002-7319-2192');
----
5909	9264,9265,9266,9267,9268,9269,9270	2389	1498	address:3527,external-identifier:3995,keyword:5097,other-name:5813

query IIII
SELECT count(*) FILTER (WHERE assertion_origin_client_id IS NOT NULL),
       count(DISTINCT assertion_origin_name),
       min(assertion_origin_name),
       count(*) FILTER (WHERE (assertion_origin_name IS NULL) <> (assertion_origin_orcid IS NULL))
FROM (SELECT assertion_origin_name, assertion_origin_orcid, assertion_origin_client_id FROM orcid_fundings('reference/orcid-model/record_3.0/samples/read_samples/record-full-3.0.json')
      UNION ALL SELECT assertion_origin_name, assertion_origin_orcid, assertion_origin_client_id FROM orcid_affiliations('reference/orcid-model/record_3.0/samples/read_samples/record-full-3.0.json')
      UNION ALL SELECT assertion_origin_name, assertion_origin_orcid, assertion_origin_client_id FROM orcid_peer_reviews('reference/orcid-model/record_3.0/samples/read_samples/record-full-3.0.json')
      UNION ALL SELECT assertion_origin_name, assertion_origin_orcid, assertion_origin_client_id FROM orcid_research_resources('reference/orcid-model/record_3.0/samples/read_samples/record-full-3.0.json')
      UNION ALL SELECT assertion_origin_name, assertion_origin_orcid, assertion_origin_client_id FROM orcid_person_items('reference/orcid-model/record_3.0/samples/read_samples/record-full-3.0.json')
      UNION ALL SELECT assertion_origin_name, assertion_origin_orcid, assertion_origin_client_id FROM orcid_history('reference/orcid-model/record_3.0/samples/read_samples/record-full-3.0.json'));
----
0	1	Three releasecandidate1	0

