# ---------------------------------------------------------------- research resource
# The JSON drops the resource-items wrapper ("resource-item": [...] next to
# "proposal"). It fills the proposal's translated title and the items' url,
# and an external-id-url on every id; the XML does neither.

query I
SELECT sum(n)::BIGINT FROM (
  (SELECT count(*) AS n FROM (SELECT COLUMNS(* EXCLUDE (source_hash, translated_title, translated_title_language)) IS NULL FROM orcid_research_resources('reference/orcid-model/record_3.0/samples/write_samples/research-resource-3.0.json')
   EXCEPT
   SELECT COLUMNS(* EXCLUDE (source_hash, translated_title, translated_title_language)) IS NULL FROM orcid_research_resources('reference/orcid-model/record_3.0/samples/write_samples/research-resource-3.0.xml')))
  UNION ALL
  (SELECT count(*) AS n FROM (SELECT COLUMNS(* EXCLUDE (source_hash, translated_title, translated_title_language)) IS NULL FROM orcid_research_resources('reference/orcid-model/record_3.0/samples/write_samples/research-resource-3.0.xml')
   EXCEPT
   SELECT COLUMNS(* EXCLUDE (source_hash, translated_title, translated_title_language)) IS NULL FROM orcid_research_resources('reference/orcid-model/record_3.0/samples/write_samples/research-resource-3.0.json')))
  UNION ALL
  (SELECT count(*) AS n FROM (SELECT COLUMNS(* EXCLUDE (source_hash, url)) IS NULL FROM orcid_research_resource_items('reference/orcid-model/record_3.0/samples/write_samples/research-resource-3.0.json')
   EXCEPT
   SELECT COLUMNS(* EXCLUDE (source_hash, url)) IS NULL FROM orcid_research_resource_items('reference/orcid-model/record_3.0/samples/write_samples/research-resource-3.0.xml')))
  UNION ALL
  (SELECT count(*) AS n FROM (SELECT COLUMNS(* EXCLUDE (source_hash, url)) IS NULL FROM orcid_research_resource_items('reference/orcid-model/record_3.0/samples/write_samples/research-resource-3.0.xml')
   EXCEPT
   SELECT COLUMNS(* EXCLUDE (source_hash, url)) IS NULL FROM orcid_research_resource_items('reference/orcid-model/record_3.0/samples/write_samples/research-resource-3.0.json')))
  UNION ALL
  (SELECT count(*) AS n FROM (SELECT COLUMNS(* EXCLUDE (source_hash, url)) IS NULL FROM orcid_external_ids('reference/orcid-model/record_3.0/samples/write_samples/research-resource-3.0.json')
   EXCEPT
   SELECT COLUMNS(* EXCLUDE (source_hash, url)) IS NULL FROM orcid_external_ids('reference/orcid-model/record_3.0/samples/write_samples/research-resource-3.0.xml')))
  UNION ALL
  (SELECT count(*) AS n FROM (SELECT COLUMNS(* EXCLUDE (source_hash, url)) IS NULL FROM orcid_external_ids('reference/orcid-model/record_3.0/samples/write_samples/research-resource-3.0.xml')
   EXCEPT
   SELECT COLUMNS(* EXCLUDE (source_hash, url)) IS NULL FROM orcid_external_ids('reference/orcid-model/record_3.0/samples/write_samples/research-resource-3.0.json'))));
----
0

