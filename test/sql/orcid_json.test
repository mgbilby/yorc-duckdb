       (SELECT count(*) FROM orcid_external_ids('reference/orcid-model/record_3.0/samples/read_samples/record-full-3.0.json')),
       (SELECT count(*) FROM orcid_person('reference/orcid-model/record_3.0/samples/read_samples/record-full-3.0.json')),
       (SELECT count(*) FROM orcid_person_items('reference/orcid-model/record_3.0/samples/read_samples/record-full-3.0.json')),
