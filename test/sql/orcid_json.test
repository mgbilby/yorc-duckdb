# ---------------------------------------------------------------- works
# work-full-3.0.json gives its first contributor an email, work-full-3.0.xml has none

query I
SELECT sum(n)::BIGINT FROM (
  (SELECT count(*) AS n FROM (SELECT COLUMNS(* EXCLUDE (source_hash)) IS NULL FROM orcid_works('reference/orcid-model/record_3.0/samples/write_samples/work-full-3.0.json')
   EXCEPT
   SELECT COLUMNS(* EXCLUDE (source_hash)) IS NULL FROM orcid_works('reference/orcid-model/record_3.0/samples/write_samples/work-full-3.0.xml')))
  UNION ALL
  (SELECT count(*) AS n FROM (SELECT COLUMNS(* EXCLUDE (source_hash)) IS NULL FROM orcid_works('reference/orcid-model/record_3.0/samples/write_samples/work-full-3.0.xml')
   EXCEPT
   SELECT COLUMNS(* EXCLUDE (source_hash)) IS NULL FROM orcid_works('reference/orcid-model/record_3.0/samples/write_samples/work-full-3.0.json')))
  UNION ALL
  (SELECT count(*) AS n FROM (SELECT COLUMNS(* EXCLUDE (source_hash)) IS NULL FROM orcid_external_ids('reference/orcid-model/record_3.0/samples/write_samples/work-full-3.0.json')
   EXCEPT
   SELECT COLUMNS(* EXCLUDE (source_hash)) IS NULL FROM orcid_external_ids('reference/orcid-model/record_3.0/samples/write_samples/work-full-3.0.xml')))
  UNION ALL
  (SELECT count(*) AS n FROM (SELECT COLUMNS(* EXCLUDE (source_hash)) IS NULL FROM orcid_external_ids('reference/orcid-model/record_3.0/samples/write_samples/work-full-3.0.xml')
   EXCEPT
   SELECT COLUMNS(* EXCLUDE (source_hash)) IS NULL FROM orcid_external_ids('reference/orcid-model/record_3.0/samples/write_samples/work-full-3.0.json')))
  UNION ALL
  (SELECT count(*) AS n FROM (SELECT COLUMNS(* EXCLUDE (source_hash, email)) IS NULL FROM orcid_contributors('reference/orcid-model/record_3.0/samples/write_samples/work-full-3.0.json')
   EXCEPT
   SELECT COLUMNS(* EXCLUDE (source_hash, email)) IS NULL FROM orcid_contributors('reference/orcid-model/record_3.0/samples/write_samples/work-full-3.0.xml')))
  UNION ALL
  (SELECT count(*) AS n FROM (SELECT COLUMNS(* EXCLUDE (source_hash, email)) IS NULL FROM orcid_contributors('reference/orcid-model/record_3.0/samples/write_samples/work-full-3.0.xml')
   EXCEPT
   SELECT COLUMNS(* EXCLUDE (source_hash, email)) IS NULL FROM orcid_contributors('reference/orcid-model/record_3.0/samples/write_samples/work-full-3.0.json'))));
