# researcher-url-3.0.json: url-name "Url name", url {"value": "https://example.com"}; the no-name file has the url only
query IIII
SELECT a.kind, a.value, a.url, b.value IS NULL AND b.url = a.url
FROM orcid_person_items('reference/orcid-model/record_3.0/samples/write_samples/researcher-url-3.0.json') a,
     orcid_person_items('reference/orcid-model/record_3.0/samples/write_samples/researcher-url-no-name-3.0.json') b;
----
researcher-url	Url name	https://example.com	true

# ---------------------------------------------------------------- the seven affiliation types
# The JSON carries no type (the API takes it from the URL), so json_root names it.

statement error
SELECT * FROM orcid_affiliations('reference/orcid-model/record_3.0/samples/write_samples/employment-3.0.json');
----
pass json_root := 'employment'

foreach type distinction education employment invited-position membership qualification service

query I
SELECT count(*) FROM (
  (SELECT COLUMNS(* EXCLUDE (source_hash)) IS NULL FROM orcid_affiliations('reference/orcid-model/record_3.0/samples/write_samples/${type}-3.0.json', json_root := '${type}')
   EXCEPT
   SELECT COLUMNS(* EXCLUDE (source_hash)) IS NULL FROM orcid_affiliations('reference/orcid-model/record_3.0/samples/write_samples/${type}-3.0.xml'))
  UNION ALL
  (SELECT COLUMNS(* EXCLUDE (source_hash)) IS NULL FROM orcid_affiliations('reference/orcid-model/record_3.0/samples/write_samples/${type}-3.0.xml')
   EXCEPT
   SELECT COLUMNS(* EXCLUDE (source_hash)) IS NULL FROM orcid_affiliations('reference/orcid-model/record_3.0/samples/write_samples/${type}-3.0.json', json_root := '${type}')));
