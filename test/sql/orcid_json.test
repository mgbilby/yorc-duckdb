# API messages (ORCID publishes no JSON samples for them: these JSON texts are the
# XML samples of reference/orcid-model written out in ORCID's JSON conventions)
# error-3.0.xml
query IIIIII
SELECT a.response_code, a.developer_message, a.user_message, a.error_code, a.more_info,
       (SELECT count(*) FROM (SELECT * EXCLUDE (source_hash) FROM orcid_errors('reference/orcid-model/record_3.0/samples/read_samples/error-3.0.xml')
                              EXCEPT SELECT * EXCLUDE (source_hash) FROM orcid_errors_json('{"response-code": 0, "developer-message": "error:developer-message", "user-message": "error:user-message", "error-code": 0, "more-info": "http://tempuri.org"}')))
FROM orcid_errors_json('{"response-code": 0, "developer-message": "error:developer-message", "user-message": "error:user-message", "error-code": 0, "more-info": "http://tempuri.org"}') a;
----
0	error:developer-message	error:user-message	0	http://tempuri.org	0

# search-3.0.xml: num-found="1", one result
query IIIII
SELECT num_found, ordinal, orcid, orcid_uri, item
FROM orcid_search_results_json('{"result": [{"orcid-identifier": {"uri": "https://orcid.org/8888-8888-8888-8880", "path": "8888-8888-8888-8880", "host": "orcid.org"}}], "num-found": 1}');
----
1	1	8888-8888-8888-8880	https://orcid.org/8888-8888-8888-8880	result

# bulk-work-err.xml: a work, then an error at entry 2
query IIII
SELECT container, position, response_code, error_code
FROM orcid_errors_json('{"bulk": [{"work": {"put-code": 156043, "title": {"title": {"value": "W"}}, "type": "journal-article"}}, {"error": {"response-code": 400, "developer-message": "Invalid work type", "user-message": "Please specify a work type.", "error-code": 9037, "more-info": "http://members.orcid.org/api/api-error-codes"}}]}');
----
bulk	2	400	9037

# summary-3.0.xml: put-code is an element of the summary items (also in JSON)
query IIII
SELECT kind, put_code, type, validated
FROM orcid_summary_items_json('{"orcid-identifier": {"uri": "https://orcid.org/8888-8888-8888-8880", "path": "8888-8888-8888-8880", "host": "orcid.org"}, "employments": {"count": 5, "employment": [{"put-code": 1, "type": "employment", "organization-name": "Fake role title 1", "validated": false}]}}');
----
employment	1	employment	false

query I
SELECT employment_count FROM orcid_summary_json('{"orcid-identifier": {"uri": "https://orcid.org/8888-8888-8888-8880", "path": "8888-8888-8888-8880", "host": "orcid.org"}, "employments": {"count": 5, "employment": []}}');
----
5

# ---------------------------------------------------------------- orcid_changes across formats

# the identical pair: no changes, whichever format each side is in
query I
SELECT count(*) FROM orcid_changes('reference/orcid-model/record_3.0/samples/write_samples/external-identifier-3.0.xml',
                                   'reference/orcid-model/record_3.0/samples/write_samples/external-identifier-3.0.json');
----
0

query IIII
SELECT section, kind, change, field
FROM orcid_changes_json('{"content": "a"}', '{"content": "b"}', json_root := 'keyword');
----
person_items	keyword	modified	value

query III
SELECT section, change, count(*)
FROM orcid_changes_json(NULL, (SELECT content FROM read_text('reference/orcid-model/record_3.0/samples/read_samples/record-full-3.0.json')))
GROUP BY ALL ORDER BY section;
----
affiliations	added	10
fundings	added	2
history	added	1
peer_reviews	added	2
person	added	1
person_items	added	13
research_resources	added	1
works	added	1
