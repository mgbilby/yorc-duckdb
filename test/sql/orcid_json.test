# bulk: bulk-work-3.0.xml dates both works, bulk-work-3.0.json neither;
# the JSON's second identifier (isbn, part-of) has no url
# and is not a self DOI, so that work has no doi (both XML works have one)
query I
SELECT sum(n)::BIGINT FROM (
  (SELECT count(*) AS n FROM (SELECT COLUMNS(* EXCLUDE (source_hash, pub_year, pub_month, pub_day, doi)) IS NULL FROM orcid_works('reference/orcid-model/record_3.0/samples/write_samples/bulk-work-3.0.json')
   EXCEPT
   SELECT COLUMNS(* EXCLUDE (source_hash, pub_year, pub_month, pub_day, doi)) IS NULL FROM orcid_works('reference/orcid-model/record_3.0/samples/write_samples/bulk-work-3.0.xml')))
  UNION ALL
  (SELECT count(*) AS n FROM (SELECT COLUMNS(* EXCLUDE (source_hash, pub_year, pub_month, pub_day, doi)) IS NULL FROM orcid_works('reference/orcid-model/record_3.0/samples/write_samples/bulk-work-3.0.xml')
   EXCEPT
   SELECT COLUMNS(* EXCLUDE (source_hash, pub_year, pub_month, pub_day, doi)) IS NULL FROM orcid_works('reference/orcid-model/record_3.0/samples/write_samples/bulk-work-3.0.json')))
  UNION ALL
  (SELECT count(*) AS n FROM (SELECT COLUMNS(* EXCLUDE (source_hash, url)) IS NULL FROM orcid_external_ids('reference/orcid-model/record_3.0/samples/write_samples/bulk-work-3.0.json')
   EXCEPT
   SELECT COLUMNS(* EXCLUDE (source_hash, url)) IS NULL FROM orcid_external_ids('reference/orcid-model/record_3.0/samples/write_samples/bulk-work-3.0.xml')))
  UNION ALL
  (SELECT count(*) AS n FROM (SELECT COLUMNS(* EXCLUDE (source_hash, url)) IS NULL FROM orcid_external_ids('reference/orcid-model/record_3.0/samples/write_samples/bulk-work-3.0.xml')
   EXCEPT
   SELECT COLUMNS(* EXCLUDE (source_hash, url)) IS NULL FROM orcid_external_ids('reference/orcid-model/record_3.0/samples/write_samples/bulk-work-3.0.json'))));
