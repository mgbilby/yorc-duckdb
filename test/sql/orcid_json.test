true

endloop

# employment-3.0.json values; 3 external ids (2 grant_number self, 1 doi part-of)
query IIIIIIIIII
SELECT department, role_title, start_year, start_month, end_year, org_name, org_city, org_country,
       org_disambiguated_id, url
FROM orcid_affiliations('reference/orcid-model/record_3.0/samples/write_samples/employment-3.0.json', json_root := 'employment');
