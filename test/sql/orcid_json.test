# ---------------------------------------------------------------- funding
# funding-3.0-simple.json fills organization/address/region, funding-3.0.xml does not

query I
SELECT count(*) FROM (
  (SELECT COLUMNS(* EXCLUDE (source_hash, org_region)) IS NULL FROM orcid_fundings('reference/orcid-model/record_3.0/samples/write_samples/funding-3.0-simple.json')
   EXCEPT
   SELECT COLUMNS(* EXCLUDE (source_hash, org_region)) IS NULL FROM orcid_fundings('reference/orcid-model/record_3.0/samples/write_samples/funding-3.0.xml'))
  UNION ALL
  (SELECT COLUMNS(* EXCLUDE (source_hash, org_region)) IS NULL FROM orcid_fundings('reference/orcid-model/record_3.0/samples/write_samples/funding-3.0.xml')
   EXCEPT
   SELECT COLUMNS(* EXCLUDE (source_hash, org_region)) IS NULL FROM orcid_fundings('reference/orcid-model/record_3.0/samples/write_samples/funding-3.0-simple.json')));
----
0

query IIIIIIIIII
SELECT type, organization_defined_type, title, translated_title, translated_title_language, amount, currency,
       start_year, org_name, org_disambiguation_source
FROM orcid_fundings('reference/orcid-model/record_3.0/samples/write_samples/funding-3.0-simple.json');
----
grant	Funding sub-type	Grant title	Translated title	en	1000.0	ADP	2000	ORCID	ROR

query II
SELECT count(*), string_agg(value, ',' ORDER BY value)
FROM orcid_external_ids('reference/orcid-model/record_3.0/samples/write_samples/funding-3.0-simple.json');
----
3	1234567,987654321,PTDC/NEU

# funding-3.0-with-NISO-roles.json (no XML twin): 18 contributors, every
# "contributor-email" null (python3 -I); no put-code, so no owner either
query III
SELECT count(*), count(email), count(owner)
FROM orcid_contributors('reference/orcid-model/record_3.0/samples/write_samples/funding-3.0-with-NISO-roles.json');
----
18	0	0

query II
SELECT credit_name, role FROM orcid_contributors('reference/orcid-model/record_3.0/samples/write_samples/funding-3.0-with-NISO-roles.json') WHERE ordinal <= 2 ORDER BY ordinal;
----
Jordan Holt	lead
Fran Alsina	co-lead

# ---------------------------------------------------------------- peer reviews
# the full JSON samples fill subject-name/subtitle, their XML twins do not;
# peer-review-simple-3.0.json fills review-url, its XML twin does not

query I
SELECT count(*) FROM (
  (SELECT COLUMNS(* EXCLUDE (source_hash, subject_subtitle)) IS NULL FROM orcid_peer_reviews('reference/orcid-model/record_3.0/samples/write_samples/peer-review-full-3.0.json')
   EXCEPT
   SELECT COLUMNS(* EXCLUDE (source_hash, subject_subtitle)) IS NULL FROM orcid_peer_reviews('reference/orcid-model/record_3.0/samples/write_samples/peer-review-full-3.0.xml'))
  UNION ALL
  (SELECT COLUMNS(* EXCLUDE (source_hash, subject_subtitle)) IS NULL FROM orcid_peer_reviews('reference/orcid-model/record_3.0/samples/write_samples/peer-review-full-3.0.xml')
   EXCEPT
   SELECT COLUMNS(* EXCLUDE (source_hash, subject_subtitle)) IS NULL FROM orcid_peer_reviews('reference/orcid-model/record_3.0/samples/write_samples/peer-review-full-3.0.json'))
  UNION ALL
  (SELECT COLUMNS(* EXCLUDE (source_hash, subject_subtitle)) IS NULL FROM orcid_peer_reviews('reference/orcid-model/record_3.0/samples/write_samples/peer-review-full-3.0-award-subject-type.json')
   EXCEPT
   SELECT COLUMNS(* EXCLUDE (source_hash, subject_subtitle)) IS NULL FROM orcid_peer_reviews('reference/orcid-model/record_3.0/samples/write_samples/peer-review-full-award-subject-type-3.0.xml'))
  UNION ALL
  (SELECT COLUMNS(* EXCLUDE (source_hash, subject_subtitle)) IS NULL FROM orcid_peer_reviews('reference/orcid-model/record_3.0/samples/write_samples/peer-review-full-award-subject-type-3.0.xml')
   EXCEPT
   SELECT COLUMNS(* EXCLUDE (source_hash, subject_subtitle)) IS NULL FROM orcid_peer_reviews('reference/orcid-model/record_3.0/samples/write_samples/peer-review-full-3.0-award-subject-type.json'))
  UNION ALL
  (SELECT COLUMNS(* EXCLUDE (source_hash, review_url)) IS NULL FROM orcid_peer_reviews('reference/orcid-model/record_3.0/samples/write_samples/peer-review-simple-3.0.json')
   EXCEPT
   SELECT COLUMNS(* EXCLUDE (source_hash, review_url)) IS NULL FROM orcid_peer_reviews('reference/orcid-model/record_3.0/samples/write_samples/peer-review-simple-3.0.xml'))
  UNION ALL
  (SELECT COLUMNS(* EXCLUDE (source_hash, review_url)) IS NULL FROM orcid_peer_reviews('reference/orcid-model/record_3.0/samples/write_samples/peer-review-simple-3.0.xml')
   EXCEPT
   SELECT COLUMNS(* EXCLUDE (source_hash, review_url)) IS NULL FROM orcid_peer_reviews('reference/orcid-model/record_3.0/samples/write_samples/peer-review-simple-3.0.json')));
----
0

