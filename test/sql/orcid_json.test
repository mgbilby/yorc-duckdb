Primary Care Health Services	Role	2021	1	2023	Boston University	Boston	US	https://ror.org/05qwgg493	https://example.com

query III
SELECT count(*), count(*) FILTER (WHERE relationship = 'self'), string_agg(DISTINCT type, ',' ORDER BY type)
FROM orcid_external_ids('reference/orcid-model/record_3.0/samples/write_samples/employment-3.0.json', json_root := 'employment');
