# name: test/sql/orcid_json.test
# description: ORCID v3.0 JSON reads into the same rows as the XML: the JSON/XML sample pairs of reference/orcid-model, the record JSON sample, format detection in files, globs and archives, the _json twins and orcid_changes_json
# group: [orcid]
#
# Expected values come from the sample files: the JSON with python3 -I (json
# module) and by reading, the XML by grep. Paths below:
#   W = reference/orcid-model/record_3.0/samples/write_samples/
#   R = reference/orcid-model/record_3.0/samples/read_samples/
#
# Of the 20 JSON/XML write-sample pairs only two carry the same values
# (external-identifier-3.0, other-name-3.0 / other-names-3.0); they must give
# identical rows (EXCEPT both ways, source_hash aside: it hashes each file).
# The other pairs describe different items with the same structure, so for
# them the rows must have the same NULL pattern (COLUMNS(*) IS NULL, EXCEPT
# both ways), minus the columns one file of the pair fills and the other does
# not (listed per pair, found by comparing the element paths of the two
# files), and the JSON values are checked against the JSON file.

require yorc

# ---------------------------------------------------------------- the two identical pairs

query I
SELECT count(*) FROM (
  (SELECT * EXCLUDE (source_hash) FROM orcid_person_items('reference/orcid-model/record_3.0/samples/write_samples/external-identifier-3.0.json')
   EXCEPT
   SELECT * EXCLUDE (source_hash) FROM orcid_person_items('reference/orcid-model/record_3.0/samples/write_samples/external-identifier-3.0.xml'))
  UNION ALL
  (SELECT * EXCLUDE (source_hash) FROM orcid_person_items('reference/orcid-model/record_3.0/samples/write_samples/external-identifier-3.0.xml')
   EXCEPT
   SELECT * EXCLUDE (source_hash) FROM orcid_person_items('reference/orcid-model/record_3.0/samples/write_samples/external-identifier-3.0.json')));
----
0

# both files: My ID System / A-0003 / https://myid.com/A-0003 / self
query IIIII
SELECT kind, type, value, url, relationship
FROM orcid_person_items('reference/orcid-model/record_3.0/samples/write_samples/external-identifier-3.0.json');
----
external-identifier	My ID System	A-0003	https://myid.com/A-0003	self

# {"content": ...} is an other name or a keyword: ORCID's JSON does not say which
statement error
SELECT * FROM orcid_person_items('reference/orcid-model/record_3.0/samples/write_samples/other-names-3.0.json');
----
json_root

query I
SELECT count(*) FROM (
  (SELECT * EXCLUDE (source_hash) FROM orcid_person_items('reference/orcid-model/record_3.0/samples/write_samples/other-names-3.0.json', json_root := 'other-name')
   EXCEPT
   SELECT * EXCLUDE (source_hash) FROM orcid_person_items('reference/orcid-model/record_3.0/samples/write_samples/other-name-3.0.xml'))
  UNION ALL
  (SELECT * EXCLUDE (source_hash) FROM orcid_person_items('reference/orcid-model/record_3.0/samples/write_samples/other-name-3.0.xml')
   EXCEPT
   SELECT * EXCLUDE (source_hash) FROM orcid_person_items('reference/orcid-model/record_3.0/samples/write_samples/other-names-3.0.json', json_root := 'other-name')));
----
0

query II
SELECT kind, value
FROM orcid_person_items('reference/orcid-model/record_3.0/samples/write_samples/other-names-3.0.json', json_root := 'other-name');
----
other-name	Other Name

# ---------------------------------------------------------------- person items (same NULL pattern; JSON values)

query I
SELECT count(*) FROM (
  (SELECT COLUMNS(* EXCLUDE (source_hash)) IS NULL FROM orcid_person_items('reference/orcid-model/record_3.0/samples/write_samples/address-3.0.json')
   EXCEPT
   SELECT COLUMNS(* EXCLUDE (source_hash)) IS NULL FROM orcid_person_items('reference/orcid-model/record_3.0/samples/write_samples/address-3.0.xml'))
  UNION ALL
  (SELECT COLUMNS(* EXCLUDE (source_hash)) IS NULL FROM orcid_person_items('reference/orcid-model/record_3.0/samples/write_samples/address-3.0.xml')
   EXCEPT
   SELECT COLUMNS(* EXCLUDE (source_hash)) IS NULL FROM orcid_person_items('reference/orcid-model/record_3.0/samples/write_samples/address-3.0.json')));
----
0

# address-3.0.json {"country": {"value": "CA"}}; address-3.0.xml <address:country>US
query II
SELECT (SELECT kind || '=' || value FROM orcid_person_items('reference/orcid-model/record_3.0/samples/write_samples/address-3.0.json')),
       (SELECT kind || '=' || value FROM orcid_person_items('reference/orcid-model/record_3.0/samples/write_samples/address-3.0.xml'));
----
address=CA	address=US

query I
SELECT count(*) FROM (
  (SELECT COLUMNS(* EXCLUDE (source_hash)) IS NULL FROM orcid_person_items('reference/orcid-model/record_3.0/samples/write_samples/keywords-3.0.json', json_root := 'keyword')
   EXCEPT
   SELECT COLUMNS(* EXCLUDE (source_hash)) IS NULL FROM orcid_person_items('reference/orcid-model/record_3.0/samples/write_samples/keyword-3.0.xml'))
  UNION ALL
  (SELECT COLUMNS(* EXCLUDE (source_hash)) IS NULL FROM orcid_person_items('reference/orcid-model/record_3.0/samples/write_samples/keyword-3.0.xml')
   EXCEPT
   SELECT COLUMNS(* EXCLUDE (source_hash)) IS NULL FROM orcid_person_items('reference/orcid-model/record_3.0/samples/write_samples/keywords-3.0.json', json_root := 'keyword')));
----
0

# keywords-3.0.json {"content": "keyword"}
query II
SELECT kind, value FROM orcid_person_items('reference/orcid-model/record_3.0/samples/write_samples/keywords-3.0.json', json_root := 'keyword');
----
