# name: test/sql/orcid_lateral_memory.test
# description: deriving a section from a one-row stage stays within a small memory limit (O(document + chunk)) when the XML is passed as a constant argument; a multi-row lateral derive does too
# group: [orcid]

require yorc

# Background (docs/REFERENCE.md, "Memory of lateral joins"): DuckDB plans
# `FROM stage s, orcid_works_xml(s.xml) w` as a delim join whose inner hash
# join is keyed on the correlated column, the whole document. When the outer
# side has ONE row, the join-order estimate of the delim scan rounds to 0 and
# the in-out side becomes the hash join's build side, so every output row keeps
# its own copy of the document: memory = document size x rows (382 x 1.3 MB
# ~ 500 MB here; 1,362 x 5.4 MB ~ 7.5 GB for the largest corpus record). With
# two or more outer rows the outer side is built and memory stays bounded. The
# form below, which passes the XML as a constant argument, is never decorrelated.

statement ok
CREATE TEMP TABLE stage AS
SELECT '0000-0003-0100-6634' AS orcid, 'h1' AS source_hash, content AS xml
FROM read_text('test/data/0000-0003-0100-6634.xml');

statement ok
CREATE TABLE works AS SELECT * FROM orcid_works_xml(NULL);

statement ok
SET memory_limit = '64MB';

# one-row stage: constant argument, cross joined for the REPLACE columns
statement ok
INSERT INTO works BY NAME
  SELECT w.* REPLACE (s.orcid AS orcid, s.source_hash AS source_hash)
  FROM stage s, orcid_works_xml((SELECT xml FROM stage)) w;

# 382: the same count orcid_works_xml.test reads from this file
query IIII
SELECT count(*), sum(put_code), min(orcid), min(source_hash) FROM works;
----
382	36003218443	0000-0003-0100-6634	h1

# with more than one staged row the constant form refuses instead of mixing documents
statement error
INSERT INTO works BY NAME
  SELECT w.* REPLACE (s.orcid AS orcid, s.source_hash AS source_hash)
  FROM (SELECT * FROM stage UNION ALL SELECT * FROM stage) s, orcid_works_xml((SELECT xml FROM stage UNION ALL SELECT xml FROM stage)) w;
----
More than one row returned by a subquery

# an empty stage derives nothing, like the lateral form
statement ok
CREATE TEMP TABLE empty_stage AS SELECT * FROM stage LIMIT 0;

query I
SELECT count(*) FROM empty_stage s, orcid_works_xml((SELECT xml FROM empty_stage)) w;
----
0

# two or more staged rows: the pinned lateral derive (CONTRACT.md) stays bounded too
statement ok
CREATE TEMP TABLE stage2 AS
SELECT * FROM stage
UNION ALL
SELECT '0000-0002-8635-8390', 'h2', content FROM read_text('test/data/activities/0000-0002-8635-8390_works_30089981.xml');

statement ok
DELETE FROM works;

statement ok
INSERT INTO works BY NAME
  SELECT w.* REPLACE (s.orcid AS orcid, s.source_hash AS source_hash)
  FROM stage2 s, orcid_works_xml(s.xml) w;

query II
SELECT source_hash, count(*) FROM works GROUP BY ALL ORDER BY ALL;
----
h1	382
h2	1
