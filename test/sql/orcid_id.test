# name: test/sql/orcid_id.test
# description: orcid_valid / orcid_normalize (ISO 7064 MOD 11-2)
# group: [orcid]

# Before we load the extension, this will fail
statement error
SELECT orcid_valid('0000-0003-0100-6634');
----
orcid_valid

require yorc

query IIIII
SELECT orcid_valid('0000-0003-0100-6634'),
       orcid_valid('0000-0003-0100-6635'),
       orcid_valid('0000-0003-0100'),
       orcid_valid('abcd-0003-0100-6634'),
       orcid_valid(NULL);
----
true	false	false	false	NULL

query III
SELECT orcid_normalize('https://orcid.org/0000-0002-1825-0097'),
       orcid_normalize(' 000000021694233x '),
       orcid_normalize('0000-0003-0100-6635');
----
0000-0002-1825-0097	0000-0002-1694-233X	NULL

query I
SELECT orcid_normalize(NULL);
----
NULL

